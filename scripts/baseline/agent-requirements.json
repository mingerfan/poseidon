{
  "schema_version": 1,
  "scope": "Hecate -> SEAL HEVM CPU; no GPU or paid provider",
  "platform_profiles": "scripts/baseline/platform-profiles.json",
  "dependency_lock": "src/poseidon/tools/dacapo/dependency-lock.json",
  "toolchain_profile": "hecate",
  "system_commands": [
    "bash",
    "git",
    "curl",
    "timeout",
    "flock",
    "bwrap",
    "sha256sum"
  ],
  "system_note": "Linux Python >=3.10, git and bwrap at /usr/bin; bubblewrap must support unprivileged namespaces. System packages are prerequisites, never installed by this entry point.",
  "dacapo_url": "https://github.com/corelab-src/dacapo.git",
  "patch_series": [
    "dacapo-plaintext-subtraction.patch",
    "dacapo-concat-layout.patch",
    "dacapo-bootstrap-containers.patch",
    "dacapo-native-function-calls.patch",
    "dacapo-refined-function-input-types.patch",
    "dacapo-augmented-operand-order.patch",
    "dacapo-minimal-mlir-link.patch",
    "dacapo-unused-mlir-dependencies.patch",
    "dacapo-seal-runtime-exceptions.patch",
    "dacapo-gcc-qualified-casts.patch",
    "dacapo-constant-output-path.patch"
  ],
  "limits": {
    "compile_jobs": 2,
    "link_jobs": 1,
    "max_stage_seconds": 43200,
    "minimum_free_gib": 2
  },
  "stages": [
    "system_and_sandbox",
    "dacapo_and_patches",
    "locked_nix_launcher",
    "nix_metadata_and_plan",
    "sources",
    "seal",
    "toolchain",
    "shell",
    "native_compiler_and_runtime",
    "python_environment",
    "doctor",
    "optional_offline_self_tests"
  ]
}
