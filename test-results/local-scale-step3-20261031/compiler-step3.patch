+#!/usr/bin/env python3
+"""Measure native local management through the real greedy compilation path."""
+import argparse
+import json
+import re
+import subprocess
+import time
+from pathlib import Path
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument('--hecate-opt', type=Path, required=True)
+    p.add_argument('--source-dir', type=Path, required=True)
+    p.add_argument('--output-dir', type=Path, required=True)
+    p.add_argument('--widths', type=int, nargs='+', default=[2500, 25000, 250000, 500000])
+    args = p.parse_args()
+    out = args.output_dir.resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    config = json.loads((args.source_dir / 'config.json').read_text())
+    config.update(polynomialDegree=16, rescalingFactor=30,
+                  levelLowerBound=1, levelUpperBound=24,
+                  bootstrapLevelLowerBound=1, bootstrapLevelUpperBound=24)
+    (out / 'config.json').write_text(json.dumps(config))
+    spec = json.loads((args.source_dir / 'test/runtime-plan/lazy-physical-level-operator-spec.json').read_text())
+    spec['rescale_mode'] = 'native'
+    q = [(1 << (30 + i % 3)) - (i + 1) * 32768 + 1 for i in range(50)]
+    spec['context'].update(rns_moduli=q, rns_moduli_log2=[v.bit_length() for v in q],
+                           max_modulus_log2=32, default_scale_log2=40)
+    spec['levels'] = dict(lower_bound=4, upper_bound=49)
+    spec['boot_profiles'] = [dict(profile_id='local40', implementation='native',
+        input_level_min=5, input_level_max=5, input_scale_log2=40, input_components=2,
+        output_level=30, output_scale_log2=40, output_components=2,
+        latency_us_by_input_level=[85000] * 50, noise_by_input_level=None,
+        host_requirements=dict(needs_secret_key=False, needs_host_compute=False))]
+    (out / 'spec.json').write_text(json.dumps(spec))
+    # Native parameters are initialized by the DaCapo driver. Calling only
+    # proactive-rescaling would silently measure the legacy policy instead.
+    common = [str(args.hecate_opt.resolve()),
+              f'--ckks-config={out / "config.json"}',
+              f'--runtime-plan-physical-level-operator-spec-path={out / "spec.json"}',
+              '--runtime-plan-boot-profile=local40', '--native-scale-policy=local',
+              '--dacapo-precompile', '--boot-placement=greedy',
+              '--waterline=40', '--bootstrap-scale=40', '--mlir-disable-threading']
+    probe = out / 'mode-probe.mlir'
+    probe.write_text('''module { func.func @probe(%x: tensor<1x!earth.ci<0 * 0>>) -> tensor<1x!earth.ci<0 * 0>> {
+%p = "earth.constant"() {value = dense<0.125> : tensor<1xf64>, rms_var = 0.125 : f64} : () -> tensor<1x!earth.pl<0 * 0>>
+%y = "earth.mul"(%x, %p) : (tensor<1x!earth.ci<0 * 0>>, tensor<1x!earth.pl<0 * 0>>) -> tensor<1x!earth.ci<0 * 0>>
+return %y : tensor<1x!earth.ci<0 * 0>>
+}}''')
+    managed = out / 'mode-probe.managed.mlir'
+    result = subprocess.run([*common, str(probe), '-o', str(managed)],
+                            capture_output=True, text=True)
+    assert result.returncode == 0, result.stderr
+    text = managed.read_text()
+    assert 'earth.local_scale_policy' in text and 'earth.native_scale_moduli' in text, text
+    rows = []
+    ct, pt = 'tensor<1x!earth.ci<0 * 0>>', 'tensor<1x!earth.pl<0 * 0>>'
+    for width in args.widths:
+        src = out / f'{width}.input.mlir'
+        with src.open('w') as f:
+            f.write(f'module {{ func.func @reduce(%x: {ct}) -> {ct} {{\n')
+            f.write(f'%p = "earth.constant"() {{value = dense<0.125> : tensor<1xf64>, rms_var = 0.125 : f64}} : () -> {pt}\n')
+            for i in range(width):
+                f.write(f'%m{i} = "earth.mul"(%x, %p) : ({ct}, {pt}) -> {ct}\n')
+                if i:
+                    prev = f'%a{i-1}' if i > 1 else '%m0'
+                    f.write(f'%a{i} = "earth.add"({prev}, %m{i}) : ({ct}, {ct}) -> {ct}\n')
+            f.write(f'return %a{width-1} : {ct}\n}}}}\n')
+        cmd = ['/usr/bin/time', '-v', '-o', str(out / f'{width}.time.log'),
+               *common, str(src), '--mlir-timing', '-o', '/dev/null']
+        start = time.monotonic()
+        with (out / f'{width}.pass.log').open('w') as log:
+            result = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT, timeout=600)
+        log = (out / f'{width}.pass.log').read_text()
+        assert result.returncode == 0, log[-5000:]
+        timing = re.search(r'(?m)^\s*([\d.]+)\s+\([^)]*\)\s+GreedyBootstrapPlacement\s*$', log)
+        assert timing, log
+        rss = re.search(r'Maximum resident set size \(kbytes\): (\d+)', (out / f'{width}.time.log').read_text())
+        rows.append(dict(products=width, raw_instructions=2 * width,
+                         native_local_policy_verified=True,
+                         pass_scope='GreedyBootstrapPlacement: local management and greedy liveness/Boot bookkeeping',
+                         wall_seconds=time.monotonic()-start, pass_seconds=float(timing[1]),
+                         max_rss_kib=int(rss[1])))
+        (out / 'summary.json').write_text(json.dumps(rows, indent=2)+'\n')
+        print(json.dumps(rows[-1]), flush=True)
+
+
+if __name__ == '__main__':
+    main()
