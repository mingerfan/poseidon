+#!/usr/bin/env python3
+"""Replay local scale plans through physical lowering and all Boot schedulers."""
+import argparse
+import hashlib
+import json
+import math
+import runpy
+import subprocess
+import tempfile
+from pathlib import Path
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--hecate-opt', type=Path, required=True)
+    parser.add_argument('--source-dir', type=Path, required=True)
+    args = parser.parse_args()
+    fixtures = args.source_dir / 'test/runtime-plan'
+    graphs = runpy.run_path(str(fixtures / 'check-greedy.py'))
+    cases = [('chain', graphs['source'](40), .25 * 1.01 ** 40 + .25),
+             ('fanout', graphs['fanout_source'](8),
+              .25 + .25 * 1.01 ** 3 * sum(1.02 + i / 100 for i in range(8))),
+             ('reduction', graphs['reduction_source'](8),
+              (.25 + .25 * 1.01 ** 2 * sum(1.02 + i / 100 for i in range(8))) * 1.01)]
+    for seed in range(5):
+        text, expected = graphs['mixed_source'](seed)
+        cases.append((f'mixed{seed}', text, expected))
+    ct, pt = 'tensor<1x!earth.ci<0 * 0>>', 'tensor<1x!earth.pl<0 * 0>>'
+    text = f"""module {{ func.func @chain(%x: {ct}) -> {ct} {{
+%p = "earth.constant"() {{value = dense<0.125> : tensor<1xf64>, rms_var = 1.0 : f64}} : () -> {pt}
+%q = "earth.constant"() {{value = dense<0.25> : tensor<1xf64>, rms_var = 1.0 : f64}} : () -> {pt}
+%bias = "earth.constant"() {{value = dense<0.03> : tensor<1xf64>, rms_var = 1.0 : f64}} : () -> {pt}
+%square = "earth.mul"(%x, %x) : ({ct}, {ct}) -> {ct}
+%a = "earth.mul"(%x, %p) : ({ct}, {pt}) -> {ct}
+%b = "earth.mul"(%q, %square) : ({pt}, {ct}) -> {ct}
+%sum = "earth.add"(%a, %b) : ({ct}, {ct}) -> {ct}
+%biased = "earth.add"(%bias, %sum) : ({pt}, {ct}) -> {ct}
+%y = "earth.mul"(%biased, %biased) : ({ct}, {ct}) -> {ct}
+%out = "earth.add"(%y, %x) : ({ct}, {ct}) -> {ct}
+return %out : {ct}
+}}}}"""
+    cases.append(('biased_square', text, (.125 * .25 + .25 * .25 ** 2 + .03) ** 2 + .25))
+    checks = 0
+    with tempfile.TemporaryDirectory(prefix='local-scale-') as directory:
+        temp = Path(directory)
+        config = json.loads((args.source_dir / 'config.json').read_text())
+        config.update(polynomialDegree=64, rescalingFactor=30,
+                      bootstrapLevelLowerBound=1, bootstrapLevelUpperBound=24,
+                      levelLowerBound=1, levelUpperBound=24)
+        (temp / 'config.json').write_text(json.dumps(config))
+        spec = json.loads((fixtures / 'lazy-physical-level-operator-spec.json').read_text())
+        for entry in spec['operators'].values():
+            entry['supported'] = True
+            entry['latency_us_by_level'] = [10] * 50
+        moduli = [(1 << (30 + i % 3)) - (i + 1) * 32768 + 1 for i in range(50)]
+        spec.update(rescale_mode='native')
+        spec['context'].update(poly_degree=64, default_scale_log2=40, rns_moduli=moduli,
+                               rns_moduli_log2=[q.bit_length() for q in moduli], max_modulus_log2=32)
+        spec['levels'] = dict(lower_bound=4, upper_bound=49)
+        spec['boot_profiles'] = [dict(profile_id='local40', implementation='native',
+            input_level_min=5, input_level_max=5, input_scale_log2=40, input_components=2,
+            output_level=30, output_scale_log2=40, output_components=2,
+            latency_us_by_input_level=[85000] * 50, noise_by_input_level=None,
+            host_requirements=dict(needs_secret_key=False, needs_host_compute=False))]
+        spec_path = temp / 'spec.json'
+        spec_path.write_text(json.dumps(spec))
+        for strategy in ('greedy', 'depth-dp', 'optimized'):
+            for name, text, expected in cases:
+                traced, output = temp / 'input.mlir', temp / 'result.mlir'
+                traced.write_text(text)
+                command = [str(args.hecate_opt), '--dacapo', '--native-scale-policy=local',
+                    f'--boot-placement={strategy}', f'--ckks-config={temp / "config.json"}',
+                    '--waterline=40', '--bootstrap-scale=40', '--mlir-disable-threading',
+                    '--runtime-plan-format=json', '--runtime-plan-boot-profile=local40',
+                    '--runtime-plan-boot-implementation=native',
+                    f'--runtime-plan-physical-level-operator-spec-path={spec_path}',
+                    '--runtime-plan-levels-per-logical-level=1', '--runtime-plan-device-counts=1',
+                    '--runtime-plan-device-count=1', f'--runtime-plan-operator-spec-path={spec_path}',
+                    '--runtime-plan-target-id=lazy-physical-level-test',
+                    '--runtime-plan-context-id=lazy-physical-level-test',
+                    '--runtime-plan-operator-spec-id=lazy-physical-level-test-v1',
+                    '--runtime-plan-operator-spec-version=1',
+                    '--runtime-plan-operator-spec-sha256=sha256:' + hashlib.sha256(spec_path.read_bytes()).hexdigest(),
+                    str(traced), '-o', str(output)]
+                result = subprocess.run(command, capture_output=True, text=True)
+                assert result.returncode == 0, (strategy, name, result.stdout, result.stderr)
+                plan = json.loads((temp / 'result.chain.runtime-plan.json').read_text())
+                desc = {v['id']: v for v in plan['values']}
+                values = {plan['external_inputs'][0]: .25}
+                for phase in ('initialization', 'execution', 'finalization'):
+                    for step in plan[phase]:
+                        op = step.get('op', step['kind'])
+                        if op == 'encode':
+                            values[step['output']] = step['payload']['values'][0]
+                        elif op in ('transfer', 'replicate'):
+                            for target in step['outputs']:
+                                values[target] = values[step['inputs'][0]]
+                        elif 'output' in step:
+                            inputs = step['inputs']
+                            a = values[inputs[0]]
+                            b = values[inputs[1]] if len(inputs) == 2 else None
+                            if op in ('add_cc', 'add_cp'):
+                                value = a + b
+                            elif op in ('mul_cc', 'mul_cp'):
+                                value = a * b
+                            elif op == 'negate':
+                                value = -a
+                            else:
+                                value = a
+                            values[step['output']] = value
+                            if op == 'add_cc':
+                                assert abs(desc[inputs[0]]['scale_log2'] - desc[inputs[1]]['scale_log2']) <= 1e-10
+                            if op == 'rescale':
+                                source, target = desc[inputs[0]], desc[step['output']]
+                                assert target['level'] == source['level'] - 1
+                                assert abs(source['scale_log2'] - math.log2(moduli[source['level']]) - target['scale_log2']) < 1e-10
+                            if op == 'boot':
+                                assert abs(desc[inputs[0]]['scale_log2'] - 40) <= 1e-8
+                                assert desc[inputs[0]]['level'] == 5
+                assert math.isclose(values[plan['final_outputs'][0]], expected, rel_tol=1e-10, abs_tol=1e-10)
+                checks += 1
+        invalid = [arg for arg in command if not arg.startswith('--runtime-plan-physical-level-operator-spec-path=')]
+        result = subprocess.run(invalid, capture_output=True, text=True)
+        assert result.returncode != 0 and 'local scale planning requires a native OperatorSpec' in result.stderr
+    print(f'{checks} local scale graphs preserve arithmetic, actual-prime RS and fixed Boot inputs')
+
+
+if __name__ == '__main__':
+    main()
