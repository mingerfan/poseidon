+#include "hecate/Support/LocalScalePlanning.h"
+#include <cstdlib>
+#include <iostream>
+
+using namespace hecate;
+void check(bool value, const char *message) {
+  if (!value) {
+    std::cerr << message << '\n';
+    std::exit(1);
+  }
+}
+
+int main() {
+  ModulusChain chain;
+  chain.reset(std::vector<uint64_t>(24, 1ULL << 30));
+  LocalScalePlanning policy(chain, 23, 40, 18, 3, 40);
+  std::array<int64_t, 3> square{1, -1, -1};
+  // A private coefficient tree can spend the already lost branch Q to lower
+  // the join scale. Equal Q counts alone do not imply equal future Q cost.
+  LocalScaleValue high{1, 60, 60, 0, 100, 1}, low{3, 40, 40};
+  auto joined =
+      policy.choose(LocalScaleKind::AddCC, high, low, false, true, square);
+  check(joined && joined->result.level == 3 && joined->result.scale < 40.001,
+        "missed lower-scale alignment at the existing join Q");
+  check(joined->inputs[0].rescales == 1 && joined->inputs[0].retune,
+        "expected safe coefficient retuning and one RS on the higher-Q path");
+  auto upward =
+      policy.choose(LocalScaleKind::AddCC, high, low, false, false, square);
+  check(upward && upward->result.level > joined->result.level,
+        "the branch regression must actually save Q against upward alignment");
+  // A ten-bit encoded one is not assumed to be an accurate free operation.
+  auto conservative = policy.choose(LocalScaleKind::AddCC, {1, 40, 40},
+                                    {3, 60, 60}, false, true, square);
+  check(conservative && conservative->result.level == 3,
+        "do not spend extra Q merely to obtain a lower scale");
+  auto lowerBeforeSquare =
+      policy.choose(LocalScaleKind::AddCC, {1, 40, 40}, {3, 60, 60, 0, 100, 1},
+                    false, true, square);
+  check(lowerBeforeSquare && lowerBeforeSquare->result.level == 4 &&
+            lowerBeforeSquare->result.scale < 40.001 &&
+            lowerBeforeSquare->inputs[1].retune,
+        "missed pre-square lowering through safe coefficient encoding");
+  // Coefficient encoding is a real number, not an integer annotation.
+  auto coefficient =
+      policy.choose(LocalScaleKind::MulCP, {0, 40, 40}, {}, true, true, square);
+  check(coefficient && coefficient->encodingScale >= 40 &&
+            coefficient->result.scale >= 40,
+        "failed to preserve coefficient precision while planning the next "
+        "square");
+  // Mixed actual primes exercise transition replay, independent of the planner.
+  std::vector<uint64_t> primes;
+  for (unsigned i = 0; i < 24; ++i)
+    primes.push_back((1ULL << (30 + i % 3)) - (i + 1) * 65536 + 1);
+  chain.reset(primes);
+  unsigned plans = 0;
+  for (int la = 0; la < 8; ++la)
+    for (int lb = 0; lb < 8; ++lb)
+      for (double sa : {40., 50.3, 60.7})
+        for (double sb : {40., 49.9, 65.1})
+          for (bool flexible : {false, true}) {
+            LocalScaleValue a{la, sa, static_cast<int64_t>(std::ceil(sa))};
+            LocalScaleValue b{lb, sb, static_cast<int64_t>(std::ceil(sb))};
+            if (flexible) {
+              a.minShift = -10;
+              a.maxShift = 100;
+              a.edits = 2;
+            }
+            auto plan =
+                policy.choose(LocalScaleKind::AddCC, a, b, true, true, square);
+            check(plan.has_value(),
+                  "ordinary alignment should remain feasible");
+            for (unsigned side = 0; side < 2; ++side) {
+              auto state = side ? b : a;
+              const auto &action = plan->inputs[side];
+              if (action.unit)
+                check(action.shift >= 40,
+                      "unit encoding below precision floor");
+              if (action.retune)
+                check(state.flexible() && action.shift >= state.minShift &&
+                          action.shift <= state.maxShift,
+                      "retuning outside private coefficient margin");
+              if (action.unit || action.retune)
+                state.scale += action.shift;
+              state.level += action.modswitch;
+              for (unsigned r = 0; r < action.rescales; ++r) {
+                state.scale -=
+                    std::log2(static_cast<double>(primes.at(23 - state.level)));
+                ++state.level;
+              }
+              check(state.level == plan->result.level &&
+                        std::abs(state.scale - plan->result.scale) <= 1e-10,
+                    "join plan differs from sequential actual-prime replay");
+            }
+            ++plans;
+          }
+  check(!policy.choose(LocalScaleKind::MulCP, {24, 40, 40}, {}, false, true,
+                       square),
+        "out-of-chain source must be rejected");
+  check(!policy.choose(LocalScaleKind::AddCC, {0, 40, 40}, {24, 40, 40}, false,
+                       true, square),
+        "an exhausted second branch must be rejected before modulus queries");
+  std::cout << plans << " mixed-chain joins and future-square checks passed\n";
+}
