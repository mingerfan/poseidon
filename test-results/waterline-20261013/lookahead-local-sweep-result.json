  "verified_scheduler_behavior": [
    {
      "fact": "Groups are keyed by ordinal for every non-preparation task; Release, Compute and Comm count. Prepare producers do not have separate active-group tickets.",
      "source": "third_party/ckks-runtime/runtime/runtime.hpp:1377"
    },
    {
      "fact": "The lookahead cap is rank-global. A ticket retires only when its tasks have completed; increasing the cap does not increase worker count.",
      "source": "third_party/ckks-runtime/runtime/runtime.hpp:1531"
    },
    {
      "fact": "Each worker has one busy task; an output must pass API is_ready before the scheduler clears busy and dispatches another task.",
      "source": "third_party/ckks-runtime/runtime/runtime.hpp:1520"
    },
    {
      "fact": "GPU Prepare is dispatched only when the foreground worker is idle and no admitted ready foreground task is pending.",
      "source": "third_party/ckks-runtime/runtime/runtime.hpp:1616"
    },
    {
      "fact": "An iteration with no progress sleeps for 100 microseconds. This is a possible latency mechanism, not a measured attribution of the server CPU bottleneck.",
      "source": "third_party/ckks-runtime/runtime/runtime.hpp:1641"
    },
    {
      "fact": "Runtime trace flushes every event. Trace runs are therefore separated from timing repetitions.",
      "source": "third_party/ckks-runtime/runtime/runtime.hpp:341"
    }
  ],
