          "text": "   * attempted size by half until `min_size`, returning the allocated block once it succeeds."
        },
        {
          "line": 251,
          "text": "   *"
        },
        {
          "line": 252,
          "text": "   * @throws rmm::bad_alloc if `min_size` bytes cannot be allocated from upstream or maximum pool"
        },
        {
          "line": 253,
          "text": "   * size is exceeded."
        },
        {
          "line": 254,
          "text": "   *"
        },
        {
          "line": 255,
          "text": "   * @param try_size The initial requested size to try allocating."
        },
        {
          "line": 256,
          "text": "   * @param min_size The minimum requested size to try allocating."
        },
        {
          "line": 257,
          "text": "   * @param stream The stream on which the memory is to be used."
        },
        {
          "line": 258,
          "text": "   * @return block_type a block of at least `min_size` bytes"
        },
        {
          "line": 259,
          "text": "   */"
        },
        {
          "line": 260,
          "text": "  block_type try_to_expand(std::size_t try_size, std::size_t min_size, cuda_stream_view stream)"
        },
        {
          "line": 261,
          "text": "  {"
        },
        {
          "line": 262,
          "text": "    while (try_size >= min_size) {"
        },
        {
          "line": 263,
          "text": "      auto block = block_from_upstream(try_size, stream);"
        },
        {
          "line": 264,
          "text": "      if (block.has_value()) {"
        },
        {
          "line": 265,
          "text": "        current_pool_size_ += block.value().size();"
        },
        {
          "line": 266,
          "text": "        return block.value();"
        },
        {
          "line": 267,
          "text": "      }"
        },
        {
          "line": 268,
          "text": "      if (try_size == min_size) {"
        },
        {
          "line": 269,
          "text": "        break;  // only try `size` once"
        },
        {
          "line": 270,
          "text": "      }"
        },
        {
