# Build output directories. The trailing slash is intentional: source files
# such as build_type.cmake and build_package.cmake.in must remain trackable.
build*/
.vscode/
# Only ignore a generated top-level dependency directory. Vendored projects
# contain required source directories such as rmm/cmake/thirdparty/.
/thirdparty/
.clangd
.claude/
compile_commands.json
stubs/

# Generated bootstrap benchmark and Nsight Systems results.
bootstrap*.log
nsys*.log
nsys_reports/
profiles/
*.nsys-rep
*.qdrep
*.qdstrm
*workspace

# Local credentials and editor backups; only the empty example is trackable.
.env
.env.*
!.env.example
*.env.local*

# Regenerable Python bytecode and local test caches.
__pycache__/
*.py[cod]
.pytest_cache/
