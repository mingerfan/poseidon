+  auto &body = callee.front();
+  auto returned = mlir::dyn_cast<mlir::func::ReturnOp>(body.getTerminator());
+  if (!returned || returned.getNumOperands() != capacity)
+    return invalid;
+  mlir::IRMapping mapping;
+  for (size_t i = 0; i < nargs; ++i) {
+    if (args[i] >= ctxt->valueMap.size() ||
+        ctxt->valueMap[args[i]].getParentBlock() != ctxt->builder->getInsertionBlock() ||
+        ctxt->valueMap[args[i]].getType() != body.getArgument(i).getType())
+      return invalid;
+    mapping.map(body.getArgument(i), ctxt->valueMap[args[i]]);
+  }
+  for (auto &op : body.without_terminator())
+    ctxt->builder->clone(op, mapping);
+  for (size_t i = 0; i < capacity; ++i) {
+    ctxt->valueMap.push_back(mapping.lookup(returned.getOperand(i)));
+    results[i] = ctxt->valueMap.size() - 1;
+  }
+  return capacity;
 }
 
