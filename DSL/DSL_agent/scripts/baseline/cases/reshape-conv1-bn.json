      0.5,
      -0.25
    ],
    "variance": [
      0.75,
      3.75
    ],
    "gamma": [
      -1,
      4
    ],
    "beta": [
      0.125,
      0.375
    ],
    "kernel": [
      [
        [
          1
        ]
      ],
      [
        [
          2
        ]
      ]
    ],
