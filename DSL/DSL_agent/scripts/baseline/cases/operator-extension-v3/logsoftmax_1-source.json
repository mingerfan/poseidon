{
  "format": "poseidon-operator-graph-v1",
  "id": "logsoftmax_1",
  "inputs": [
    {
      "name": "x",
      "shape": [
        2,
        3
      ]
    }
  ],
  "constants": {
    "input_scale": 0.125
  },
  "nodes": [
    {
      "id": "scale_input",
      "op": "multiply",
      "inputs": [
        "x",
        "input_scale"
      ],
      "attrs": {},
      "outputs": [
        "small_x"
      ]
    },
    {
      "id": "operation",
      "op": "logsoftmax",
      "inputs": [
        "small_x"
      ],
      "attrs": {
        "axis": -1,
        "exp": {
          "method": "taylor",
          "domain": [
            -0.2,
            0.2
          ],
          "degree": 3
        },
        "log": {
          "method": "polynomial",
          "basis": "power",
          "domain": [
            1.5,
            6.0
          ],
          "coefficients": [
            -0.4013877113318902,
            0.6666666666666666,
            -0.05555555555555555
          ]
        }
      },
      "outputs": [
        "y"
      ]
    }
  ],
  "outputs": [
    {
      "name": "result",
      "value": "y"
    }
  ]
}
