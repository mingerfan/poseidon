{
  "schema": 2,
  "id": "bn-polynomial",
  "input_shape": [
    2,
    2
  ],
  "constants": {
    "mean": [
      0.5,
      -0.25
    ],
    "variance": [
      0.75,
      3.75
    ],
    "gamma": [
      -1,
      4
    ],
    "beta": [
      0.125,
      0.375
    ]
  },
  "nodes": [
    {
      "id": "norm",
      "op": "batch_norm",
      "inputs": [
        "x"
      ],
      "running_mean": "mean",
      "running_var": "variance",
      "weight": "gamma",
      "bias": "beta",
      "eps": 0.25
    },
    {
      "id": "flat",
      "op": "flatten",
      "inputs": [
        "norm"
      ]
    },
    {
      "id": "out",
      "op": "square",
      "inputs": [
        "flat"
      ]
    }
  ],
  "output": "out"
}
