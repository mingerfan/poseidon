"""Public FX provenance controls; trusted fixtures, not uploaded source."""
import copy,operator,unittest
import numpy as np
import torch
from benchmark_graph import digest
from pytorch_fused_matrix_normalization import inventory
from pytorch_public_expression_flow import normalize,check,_arrays,state_identity,expected_flow,_decode

PROFILE="general-tensors-v1"
COUNTERS=dict(contexts=0,reference_groups=0,contexts_by_operation={})
class Model(torch.nn.Module):
    def __init__(self,operation,context):
        super().__init__();self.operation=operation;self.context=context
        shape=((6,),(2,3),(2,1,3))[context]
        raw=np.arange(1,7,dtype=np.float64).reshape(shape)
        if operation=="bool_cast":raw=(raw%2==0)
        self.register_buffer("public",torch.from_numpy(raw))
    def forward(self,x):
        p=self.public
        if self.operation=="reshape":p=p.view(*((2,3),(3,2),(1,2,3))[self.context])
        elif self.operation=="permute":p=p.permute(*tuple(reversed(range(p.ndim))))
        elif self.operation=="slice":p=p[...,::2]
        elif self.operation=="bool_cast":p=p.float()
        else:p=p.contiguous()
        return x*p
    def mathematical_public(self):
        raw=self.public.detach().numpy()
        if self.operation=="reshape":return raw.reshape(((2,3),(3,2),(1,2,3))[self.context])
        if self.operation=="permute":return raw.transpose(tuple(reversed(range(raw.ndim))))
        if self.operation=="slice":return raw[...,::2]
        if self.operation=="bool_cast":return raw.astype(np.float32).astype(np.float64)
        return raw.copy()

def capture(module):
    tracer=torch.fx.Tracer();tracer.proxy_buffer_attributes=True
    traced=torch.fx.GraphModule(module,tracer.trace(module))
    for n in traced.graph.nodes:n.meta["source_order"]=[n.name]
    return traced

def prepare(module):
    source=capture(module);raw=_arrays(source);state=state_identity(raw,resource_profile=PROFILE)
    result,record=normalize(source,raw,expected_state=state,resource_profile=PROFILE)
    states,effective=check(record,raw,expected_binding=record["binding"],
                          expected_source_inventory=inventory(source),resource_profile=PROFILE)
    assert state_identity(states,resource_profile=PROFILE)==record["full_normalized_state"]
    assert state_identity(effective,resource_profile=PROFILE)==record["effective_state"]
    return source,raw,result,record

class Controls(unittest.TestCase):
    def failure(self,fn,code):
        with self.assertRaisesRegex(ValueError,code):fn()
    def test_five_partitions_three_distinct_contexts(self):
        for operation in ("reshape","permute","slice","bool_cast","identity"):
            signatures=[]
            for context in range(3):
                with self.subTest(operation=operation,context=context):
                    model=Model(operation,context);source,raw,result,record=prepare(model)
                    public=model.mathematical_public();shape=public.shape
                    probes=[np.zeros(shape),np.linspace(-1,1,public.size).reshape(shape),
                            np.random.default_rng(237+context).normal(size=shape),np.full(shape,2.)]
                    for x in probes:
                        expected=x*public
                        np.testing.assert_array_equal(model(torch.from_numpy(x)).detach().numpy(),expected)
                        np.testing.assert_array_equal(result(torch.from_numpy(x)).detach().numpy(),expected)
                    self.assertEqual(len(record["entries"]),1)
                    unchanged=[n for n in record["source_inventory"]if n["op"]not in("get_attr","call_method","call_function")]
                    for row in unchanged:self.assertIn(row,record["normalized_inventory"])
                    for node in result.graph.nodes:self.assertEqual(node.meta["source_order"],[node.name])
                    proof=record["entries"][0]["plan"]
                    signatures.append(digest(dict(shape=proof["input"]["shape"],operation=proof["operation"],
                                                  attributes=proof["attributes"])))
                    COUNTERS["contexts"]+=1;COUNTERS["reference_groups"]+=4
            self.assertEqual(len(set(signatures)),3)
            COUNTERS["contexts_by_operation"][operation]=signatures
    def test_encrypted_graph_is_unchanged(self):
        class Cipher(torch.nn.Module):
            def forward(self,x):return x.reshape(2,3).transpose(0,1).square()
        source,raw,result,record=prepare(Cipher())
        self.assertEqual(record["entries"],[]);self.assertEqual(inventory(source),inventory(result))
    def test_chain_and_original_source_immutable(self):
        class Chain(torch.nn.Module):
            def __init__(self):
                super().__init__();self.register_buffer("public",torch.arange(1,7,dtype=torch.float64))
            def forward(self,x):return x*self.public.reshape(2,3).permute(1,0)[::2]
        source,raw,result,record=prepare(Chain())
        self.assertEqual(len(record["entries"]),3)
        self.assertEqual(record["entries"][1]["source_parent"],record["entries"][0]["source_fx_node"])
        self.assertTrue(all(e["roots"]==["public"]for e in record["entries"]))
        np.testing.assert_array_equal(result(torch.ones(2,2,dtype=torch.float64)).detach().numpy(),
                                      raw["public"].reshape(2,3).transpose(1,0)[::2])
        self.assertEqual(state_identity(_arrays(source),resource_profile=PROFILE),record["original_state"])
    def test_named_output_and_declaration_order(self):
        class Outputs(Model):
            def forward(self,x):
                y=super().forward(x)
                return {"z":y,"a":[x,y],"none":None}
        source,raw,result,record=prepare(Outputs("reshape",1))
        self.assertEqual(inventory(source)[-1],inventory(result)[-1])
        self.assertEqual(list(result(torch.ones(3,2,dtype=torch.float64))),["z","a","none"])
    def test_unused_public_transform_is_retained_in_proof_and_removed_from_fx(self):
        class Unused(Model):
            def forward(self,x):
                unused=self.public.reshape(2,3)
                return x.square()
        source,raw,result,record=prepare(Unused("reshape",0))
        self.assertEqual(len(record["entries"]),1)
        self.assertIn(record["entries"][0]["source_fx_node"],record["dropped_get_attr_nodes"])
        self.assertEqual(sum(n.op=="get_attr"for n in result.graph.nodes),0)
        self.assertEqual(record["effective_state"],{})
    def test_original_unused_weights_preserved(self):
        source=capture(Model("reshape",0));source.register_buffer("unused",torch.arange(6000,dtype=torch.float64))
        raw=_arrays(source);expected=state_identity(raw,resource_profile=PROFILE)
        result,record=normalize(source,raw,expected_state=expected,resource_profile=PROFILE)
        self.assertIn("unused",result.state_dict())
        self.assertEqual(record["full_normalized_state"]["unused"],expected["unused"])
        self.assertNotIn("unused",record["effective_state"])
    def test_keyword_and_method_aliases(self):
        for spelling in ("torch.reshape","torch.permute","torch.transpose","t","T","unsqueeze","squeeze","flatten"):
            class Alias(torch.nn.Module):
                def __init__(self):
                    super().__init__();self.register_buffer("public",torch.arange(1,7,dtype=torch.float64).reshape(2,3))
                def forward(self,x):
                    p=self.public
                    if spelling=="torch.reshape":p=torch.reshape(input=p,shape=(3,2))
                    elif spelling=="torch.permute":p=torch.permute(input=p,dims=(1,0))
                    elif spelling=="torch.transpose":p=torch.transpose(input=p,dim0=0,dim1=1)
                    elif spelling=="t":p=p.t()
                    elif spelling=="T":p=p.T
                    elif spelling=="unsqueeze":p=p.unsqueeze(0)
                    elif spelling=="squeeze":p=p.unsqueeze(0).squeeze(0)
                    else:p=p.flatten()
                    return x*p
            with self.subTest(spelling=spelling):
                source,raw,result,record=prepare(Alias())
                self.assertTrue(record["entries"])
                public=list(record["effective_state"].values())[-1]
                shape=public["shape"];x=torch.ones(shape,dtype=torch.float64)
                np.testing.assert_array_equal(source(x).detach().numpy(),result(x).detach().numpy())
    def test_boolean_dtype_spellings(self):
        for spelling in ("float","double","to"):
            class Cast(torch.nn.Module):
                def __init__(self):
                    super().__init__();self.register_buffer("mask",torch.tensor([True,False]))
                def forward(self,x):
                    m=self.mask.float()if spelling=="float"else self.mask.double()if spelling=="double"else self.mask.to(dtype=torch.float64)
                    return x*m
            with self.subTest(spelling=spelling):
                _,_,result,record=prepare(Cast())
                self.assertEqual(record["entries"][0]["plan"]["operation"],"bool_cast")
                np.testing.assert_array_equal(result(torch.ones(2,dtype=torch.float64)).detach().numpy(),[1.,0.])
    def test_wrong_state_authority(self):
        source=capture(Model("reshape",0));raw=_arrays(source);expected=state_identity(raw,resource_profile=PROFILE)
        raw["public"][0]=999
        self.failure(lambda:normalize(source,raw,expected_state=expected,resource_profile=PROFILE),
                     "public_expression_original_state_binding")
    def test_derived_payload_and_record_binding(self):
        source,raw,result,record=prepare(Model("reshape",0));binding=record["binding"]
        forged=copy.deepcopy(record);forged["entries"][0]["roots"]=["other"]
        self.failure(lambda:check(forged,raw,expected_binding=binding,
                                  expected_source_inventory=inventory(source),resource_profile=PROFILE),
                     "public_expression_record_binding")
        forged["binding"]=digest({k:v for k,v in forged.items()if k!="binding"})
        self.failure(lambda:check(forged,raw,expected_binding=forged["binding"],
                                  expected_source_inventory=inventory(source),resource_profile=PROFILE),
                     "public_expression_record_changed")
    def test_wrong_source_inventory_even_when_self_rehashed(self):
        source,raw,result,record=prepare(Model("reshape",0));other=inventory(source)
        other[1]["target"]="missing"
        self.failure(lambda:check(record,raw,expected_binding=record["binding"],
                                  expected_source_inventory=other,resource_profile=PROFILE),
                     "public_expression_attribute_not_declared")
    def test_wrong_profile_rejected(self):
        source,raw,result,record=prepare(Model("reshape",0))
        self.failure(lambda:check(record,raw,expected_binding=record["binding"],
                                  expected_source_inventory=inventory(source),resource_profile="medium-v1"),
                     "public_expression_record_changed")
    def test_public_dynamic_metadata_rejected(self):
        class Dynamic(Model):
            def forward(self,x):return x*self.public.view(x.size(0),-1)
        source=capture(Dynamic("reshape",0));raw=_arrays(source)
        self.failure(lambda:normalize(source,raw,expected_state=state_identity(raw,resource_profile=PROFILE),
                                      resource_profile=PROFILE),"public_expression_dynamic_metadata")
    def test_undeclared_attribute_rejected(self):
        module=torch.nn.Module();module.side=2
        graph=torch.fx.Graph();x=graph.placeholder("x");p=graph.get_attr("side")
        graph.output(graph.call_function(operator.mul,(x,p)))
        source=torch.fx.GraphModule(module,graph)
        self.failure(lambda:normalize(source,{},expected_state={},resource_profile=PROFILE),
                     "public_expression_attribute_not_declared")
    def test_mutation_and_unregistered_public_compute_rejected(self):
        for method in ("add_","square","float"):
            class Rejected(Model):
                def forward(self,x):
                    p=self.public.add_(1)if method=="add_"else self.public.square()if method=="square"else self.public.float()
                    return x*p
            source=capture(Rejected("reshape",0));raw=_arrays(source)
            code="public_expression_bool_cast"if method=="float"else"public_expression_operation_not_registered"
            self.failure(lambda:normalize(source,raw,expected_state=state_identity(raw,resource_profile=PROFILE),
                                          resource_profile=PROFILE),code)
            self.assertEqual(state_identity(_arrays(source),resource_profile=PROFILE),state_identity(raw,resource_profile=PROFILE))
    def test_device_move_is_rejected(self):
        class Device(Model):
            def forward(self,x):return x*self.public.to("cuda")
        source=capture(Device("bool_cast",0));raw=_arrays(source)
        self.failure(lambda:normalize(source,raw,expected_state=state_identity(raw,resource_profile=PROFILE),
                                      resource_profile=PROFILE),"public_expression_cast_dtype")
    def test_materialized_name_collision(self):
        source=capture(Model("reshape",0));source.register_buffer("_poseidon_public_expression_0",torch.ones(1,dtype=torch.float64))
        raw=_arrays(source)
        self.failure(lambda:normalize(source,raw,expected_state=state_identity(raw,resource_profile=PROFILE),
                                      resource_profile=PROFILE),"public_expression_materialization_collision")
    def test_repeated_folding_deterministic(self):
        source,raw,result,record=prepare(Model("reshape",0))
        _,again=normalize(source,raw,expected_state=record["original_state"],resource_profile=PROFILE)
        self.assertEqual(record,again)
    def test_type_guard_before_array_attribute_access(self):
        class Hostile:
            @property
            def size(self):raise RuntimeError("should not run")
        self.failure(lambda:expected_flow([],{"x":Hostile()},resource_profile=PROFILE),"public_expression_array_type")
    def test_recursive_argument_capacity(self):
        value=dict(kind="none")
        for _ in range(65):value=dict(kind="tuple",items=[value])
        self.failure(lambda:_decode(value,{}),"public_expression_argument_capacity")
    def test_argument_item_capacity(self):
        self.failure(lambda:_decode(dict(kind="list",items=[dict(kind="none")]*4096),{}),
                     "public_expression_argument_capacity")
    def test_inventory_dependency_and_op_tamper(self):
        source,raw,_,_=prepare(Model("reshape",0));rows=inventory(source)
        bad=copy.deepcopy(rows);bad[2]["args"]["items"][0]["name"]="later"
        self.failure(lambda:expected_flow(bad,raw,resource_profile=PROFILE),"public_expression_inventory_dependency")
        bad=copy.deepcopy(rows);bad[2]["op"]="unknown"
        self.failure(lambda:expected_flow(bad,raw,resource_profile=PROFILE),"public_expression_inventory_operation")

if __name__=="__main__":unittest.main()
