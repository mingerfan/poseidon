"""Independent plaintext audit of the fixed bootstrap approximation.

This tool does not execute Poseidon, alter parameters, or replace acceptance
references. FFT embedding follows the CKKS odd-root definition. Chebyshev
Clenshaw evaluation is independent of the encrypted heap evaluator.
"""
import cmath
import hashlib
import json
import math
from pathlib import Path

def fft(values, sign=-1):
    a=list(values); n=len(a)
    if n==0 or n&(n-1): raise ValueError("FFT length must be a power of two")
    j=0
    for i in range(1,n):
        bit=n>>1
        while j&bit: j^=bit; bit>>=1
        j^=bit
        if i<j: a[i],a[j]=a[j],a[i]
    size=2
    while size<=n:
        step=cmath.exp(sign*2j*math.pi/size)
        for begin in range(0,n,size):
            w=1
            for k in range(begin,begin+size//2):
                u=a[k]; v=a[k+size//2]*w
                a[k]=u+v; a[k+size//2]=u-v; w*=step
        size*=2
    return a

def slot_indices(n):
    pos=1; indices=[]
    for _ in range(n//2):
        indices.append((pos-1)//2); pos=pos*5%(2*n)
    return indices

def encode_math(values):
    n=2*len(values); grid=[0j]*n
    for i,v in zip(slot_indices(n),values):
        grid[i]=v; grid[n-1-i]=complex(v).conjugate()
    return [v/n*cmath.exp(-1j*math.pi*j/n) for j,v in enumerate(fft(grid))]

def decode_math(coeff):
    n=len(coeff)
    grid=fft([v*cmath.exp(1j*math.pi*j/n) for j,v in enumerate(coeff)],1)
    return [grid[i] for i in slot_indices(n)]

def read_heap(source):
    text=source.read_text().split('R"COSINE_HEAP(')[1].split(')COSINE_HEAP"')[0]
    tokens=iter(text.split()); count=int(next(tokens)); heap={}
    while True:
        try: index=int(next(tokens))
        except StopIteration: break
        degree=int(next(tokens))
        heap[index]=[float(next(tokens)) for _ in range(degree+1)]
    if len(heap)!=count: raise ValueError("Incomplete embedded heap")
    return heap

def clenshaw(coeff,x):
    b1=b2=0.
    for c in reversed(coeff[1:]):
        b0=2*x*b1-b2+c; b2,b1=b1,b0
    return coeff[0]+x*b1-b2

def chebyshev(n,x):
    if n==0:return 1.
    a,b=1.,x
    for _ in range(2,n+1):a,b=b,2*x*b-a
    return b

def heap_value(heap,x,index=0,depth=0):
    left=2*index+1; right=left+1
    if left not in heap:return clenshaw(heap[index],x)
    # The fixed heap uses T32, T16, T8 at successive internal levels.
    return heap_value(heap,x,left,depth+1)*chebyshev(32>>depth,x)+heap_value(heap,x,right,depth+1)

def inverse_coefficient(coeff):
    return (clenshaw(coeff,0)/math.cos(math.pi/8))**4

def evalmod(coeff,x,inverse):
    y=clenshaw(coeff,x); r=inverse**.25
    for _ in range(2):r*=r; y=2*y*y-r
    return y

def sine_surrogate(values,ratio,inverse):
    coeff=encode_math(values)
    return [v.real for v in decode_math([ratio*inverse*math.sin(2*math.pi*c.real/ratio) for c in coeff])]

def audit(root,evidence):
    source=root/"src/poseidon/advance/bootstrapper.cpp"
    heap=read_heap(source); coeff=heap[0]; inverse=inverse_coefficient(coeff)
    grid=[-1+i/1000 for i in range(2001)]
    heap_error=max(abs(clenshaw(coeff,x)-heap_value(heap,x)) for x in grid)
    rows=[]
    for line in (evidence/"execute.log").read_text().splitlines():
        if line.startswith("value group=signed stage=first_refresh "):
            rows.append(dict(t.split("=",1) for t in line.split()[1:]))
    if [int(r["index"]) for r in rows]!=list(range(16384)):
        raise ValueError("Expected complete signed first-refresh evidence")
    values=[float(r["reference"]) for r in rows];actual=[float(r["actual"]) for r in rows]
    predicted=sine_surrogate(values,32,inverse)
    residual=[abs(a-p) for a,p in zip(actual,predicted)]
    error=[abs(p-v) for p,v in zip(predicted,values)]
    roundtrip=max(abs(x-y) for x,y in zip(values,decode_math(encode_math(values))))
    grouped=[]
    for x in dict.fromkeys(values):
        indices=[i for i,v in enumerate(values) if v==x]
        grouped.append(dict(reference=x,actual_mean_error=sum(actual[i]-x for i in indices)/len(indices),
                            predicted_mean_error=sum(predicted[i]-x for i in indices)/len(indices)))
    # Scalar zero-carry polynomial vs ideal sine: does not assert actual encrypted carries are zero.
    scalar=[i/6400 for i in range(-100,101)]
    poly_sine_error=max(abs(evalmod(coeff,t/25,inverse)-inverse*math.sin(2*math.pi*t)) for t in scalar)
    return dict(format="poseidon-bootstrap-math-audit-v1",
        source_sha256=hashlib.sha256(source.read_bytes()).hexdigest(),
        evidence_log_sha256=hashlib.sha256((evidence/"execute.log").read_bytes()).hexdigest(),
        evidence_library_sha256=json.loads((evidence/"report.json").read_text())["library_sha256"],
        inverse_coefficient=inverse,heap_vs_root_max_error=heap_error,
        ckks_embedding_roundtrip_max_error=roundtrip,scalar_zero_carry_poly_sine_max_error=poly_sine_error,
        signed_surrogate_max_error=max(error),actual_minus_surrogate_max_error=max(residual),
        actual_minus_surrogate_mae=sum(residual)/len(residual),
        predicted_failure_slots=sum(e>1e-5+1e-4*abs(v) for e,v in zip(error,values)),
        signed_groups=grouped,
        conclusion="Normalized sine approximation explains the dominant signed-input bias; residual includes encrypted arithmetic and polynomial/carry effects.",
        limits=["Not a new encrypted execution","Does not isolate every residual error","Not a replacement reference","No parameter change"],
        paid_calls=0)

if __name__=="__main__":
    import argparse
    parser=argparse.ArgumentParser()
    parser.add_argument("--evidence",required=True,type=Path)
    parser.add_argument("--output",required=True,type=Path)
    args=parser.parse_args()
    if args.output.exists():raise SystemExit("Refusing to overwrite audit")
    result=audit(Path(__file__).resolve().parents[2],args.evidence)
    args.output.write_text(json.dumps(result,indent=2)+"\n")
    print(json.dumps(result,indent=2))
