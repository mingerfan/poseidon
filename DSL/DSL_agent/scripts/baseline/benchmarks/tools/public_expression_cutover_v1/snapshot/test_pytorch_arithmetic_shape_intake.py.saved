"""Opt-in arithmetic result metadata, compatibility and inert provenance binding."""
import copy,json,unittest
from pathlib import Path
import numpy as np
import torch
from benchmark_graph import digest,samples
from benchmark_math import evaluate as mathematical
from benchmark_torch import evaluate as independent
from pytorch_static_trace import trace,policy_record,POLICY,INDEX_POLICY,ARITHMETIC_POLICY
from pytorch_arithmetic_normalization import normalize,rename_record,bind_record
from pytorch_model_capture import capture
from pytorch_weight_package import binding as weight_binding
import pytorch_model_intake as intake

PROFILE="general-tensors-v1"
ROOT=Path(__file__).resolve().parents[2]
SOURCE_CASES=ROOT/"scripts/baseline/cases/trusted-pytorch-shape-composition-v1"

class Method(torch.nn.Module):
    def __init__(self,method="add",query="shape"):
        super().__init__()
        self.register_buffer("public",torch.tensor([.125,-.25],dtype=torch.float64))
        self.method,self.query=method,query
    def forward(self,x):
        y=getattr(x,self.method)(self.public)
        if self.query=="shape":return y.reshape(y.shape[0]*y.shape[1])
        if self.query=="size":return y.reshape(y.size(0),-1).flatten()
        if self.query=="numel":return y.reshape(y.numel())
        if self.query=="ndim":return y.flatten(0,y.ndim-1)
        if self.query=="dim":return y.flatten(0,y.dim()-1)
        return y.reshape(len(y),-1).flatten()

def bound(version=intake.SHAPE_FORMAT):
    module=Method().eval()
    spec=json.loads((SOURCE_CASES/"shape_add_method_result_shape/manifest.json").read_text())
    spec["format"]=version
    raw=trace(module,spec["inputs"],resource_profile=PROFILE,policy=ARITHMETIC_POLICY)
    normalized,record=normalize(raw,resource_profile=PROFILE)
    canonical=trace(normalized,spec["inputs"],resource_profile=PROFILE,policy=INDEX_POLICY)
    record=rename_record(record,normalized,canonical)
    high,_,captured=capture(canonical,spec["inputs"],spec["outputs"],resource_profile=PROFILE,
        dtype_policy="strict-float64-v1",preserve_output_structure=True,record_state_sources=True,
        capture_policy=INDEX_POLICY,approximation_policy="node-module-default-v1",
        matrix_policy="static-tensor-matmul-v1",approximations=spec["approximations"])
    meta=captured["pytorch_capture"]
    meta["source_state_dtypes"]={"public":"float64"}
    meta["state_constant_sources"]={name:state for name,state in meta["state_constant_sources"].items()
                                    if state in spec["weights"]}
    meta["weight_binding"]=weight_binding({"public":module.public.numpy()},spec["weights"])
    meta["arithmetic_capture"]=bind_record(record,high,captured_fx=canonical)
    if version==intake.SHAPE_FORMAT:
        meta["source_shape_capture"]=policy_record(spec["inputs"],PROFILE,policy=ARITHMETIC_POLICY)
    return high,spec,meta

class ArithmeticShapeTests(unittest.TestCase):
    def test_registered_methods_and_six_queries(self):
        for method in ("add","sub","subtract","mul","multiply"):
            for query in ("shape","size","numel","ndim","dim","len"):
                with self.subTest(method=method,query=query):
                    module=Method(method,query).eval()
                    signature=[dict(name="x",shape=[2,2])]
                    traced=trace(module,signature,resource_profile=PROFILE,policy=ARITHMETIC_POLICY)
                    x=torch.tensor([[.5,-.75],[1.,-.125]],dtype=torch.float64)
                    np.testing.assert_allclose(traced(x).numpy(),module(x).numpy(),atol=0,rtol=0)

    def test_all_old_metadata_policies_retain_method_rejection(self):
        for policy in (POLICY,INDEX_POLICY):
            with self.subTest(policy=policy),self.assertRaisesRegex(ValueError,"Static shape unavailable"):
                trace(Method(),[dict(name="x",shape=[2,2])],resource_profile=PROFILE,policy=policy)

    def test_three_distinct_shapes_have_independent_references(self):
        for shape in ([2],[2,2],[1,2,2]):
            class Model(torch.nn.Module):
                def forward(self,x):
                    y=x.multiply(.25).add(.125).subtract(.5)
                    return y.reshape(y.numel())
            signature=[dict(name="x",shape=shape)]
            source=trace(Model(),signature,resource_profile=PROFILE,policy=ARITHMETIC_POLICY)
            normalized,_=normalize(source,resource_profile=PROFILE)
            high,core,_=capture(normalized,signature,["result"],resource_profile=PROFILE,
                capture_policy=INDEX_POLICY,dtype_policy="strict-float64-v1",
                preserve_output_structure=True,matrix_policy="static-tensor-matmul-v1")
            for inputs in samples(core,16):
                expected=Model()(torch.from_numpy(inputs["x"])).numpy()
                for fn in (mathematical,independent):
                    np.testing.assert_allclose(fn(core,inputs,resource_profile=PROFILE)["result"],
                                               expected,atol=1e-12,rtol=1e-12)

    def test_split_and_static_indexing_remain_available(self):
        class Model(torch.nn.Module):
            def forward(self,x):
                y=x.add(.125)
                a,b=y.split([1,1],dim=0)
                return a.reshape(a.numel()),b[:,1].reshape(b[:,1].numel())
        signature=[dict(name="x",shape=[2,2])]
        source=trace(Model(),signature,resource_profile=PROFILE,policy=ARITHMETIC_POLICY)
        normalized,_=normalize(source,resource_profile=PROFILE)
        _,core,_=capture(normalized,signature,["a","b"],resource_profile=PROFILE,
            capture_policy=INDEX_POLICY,dtype_policy="strict-float64-v1",
            preserve_output_structure=True,matrix_policy="static-tensor-matmul-v1")
        for inputs in samples(core,16):
            expected=Model()(torch.from_numpy(inputs["x"]))
            actual=mathematical(core,inputs,resource_profile=PROFILE)
            for name,value in zip(("a","b"),expected):
                np.testing.assert_allclose(actual[name],value.numpy(),atol=1e-12,rtol=1e-12)

    def test_public_shape_control_remains_public_and_bounded(self):
        class Model(torch.nn.Module):
            def forward(self,x):
                y=x.add(.125)
                for _ in range(y.numel()):y=y.add(.25)
                if y.dim()==2:return y.reshape(y.shape)
                return -y
        signature=[dict(name="x",shape=[2,2])]
        traced=trace(Model(),signature,resource_profile=PROFILE,policy=ARITHMETIC_POLICY)
        torch.testing.assert_close(traced(torch.zeros(2,2)),Model()(torch.zeros(2,2)))

    def test_data_dependent_control_still_rejected(self):
        class Model(torch.nn.Module):
            def forward(self,x):
                if x.add(.125).sum()>0:return x
                return -x
        with self.assertRaisesRegex(Exception,"control flow"):
            trace(Model(),[dict(name="x",shape=[2,2])],resource_profile=PROFILE,policy=ARITHMETIC_POLICY)

    def test_unknown_method_metadata_is_not_inferred(self):
        class Model(torch.nn.Module):
            def forward(self,x):
                y=x.sin()
                return y.reshape(y.numel())
        with self.assertRaisesRegex(ValueError,"Static shape unavailable"):
            trace(Model(),[dict(name="x",shape=[2,2])],resource_profile=PROFILE,policy=ARITHMETIC_POLICY)

    def test_encrypted_size_axis_still_rejected(self):
        class Model(torch.nn.Module):
            def forward(self,x):
                y=x.add(.125)
                return y.reshape(y.size(x[0,0]),-1)
        with self.assertRaisesRegex(ValueError,"Static size axis"):
            trace(Model(),[dict(name="x",shape=[2,2])],resource_profile=PROFILE,policy=ARITHMETIC_POLICY)

    def test_static_expansion_still_bounded(self):
        class Model(torch.nn.Module):
            def forward(self,x):
                y=x.add(.125)
                for _ in range(10000):y=y.add(.25)
                return y
        with self.assertRaisesRegex(ValueError,"Static FX expansion budget"):
            trace(Model(),[dict(name="x",shape=[2,2])],resource_profile=PROFILE,policy=ARITHMETIC_POLICY)

class ShapeProvenanceTests(unittest.TestCase):
    def test_explicit_version_has_distinct_formats_and_binding(self):
        high,spec,meta=bound()
        intake.check_capture_metadata(meta,high,spec,resource_profile=PROFILE)
        _,new=intake.capture_binding(high,spec,resource_profile=PROFILE,capture_metadata=meta)
        old_spec=copy.deepcopy(spec);old_spec["format"]=intake.FORMAT
        old_meta=copy.deepcopy(meta);old_meta.pop("source_shape_capture")
        _,old=intake.capture_binding(high,old_spec,resource_profile=PROFILE,capture_metadata=old_meta)
        self.assertEqual(new["capture_policy_version"],intake.SHAPE_FORMAT)
        self.assertNotEqual(new["binding_sha256"],old["binding_sha256"])
        self.assertEqual(intake.package_format(spec),intake.SHAPE_PACKAGE_FORMAT)
        self.assertNotEqual(intake.package_format(spec),intake.package_format(old_spec))

    def test_shape_policy_fields_are_strictly_bound(self):
        high,spec,meta=bound()
        changed_values=[("version",INDEX_POLICY),("input_signature_sha256","0"*64),
                        ("max_fx_compute_nodes",True),("shape_sources","inferred"),
                        ("indexing_policy","other"),("scalar_outputs","other")]
        for field,value in changed_values:
            bad=copy.deepcopy(meta);bad["source_shape_capture"][field]=value
            with self.subTest(field=field),self.assertRaisesRegex(ValueError,"source shape policy binding"):
                intake.check_capture_metadata(bad,high,spec,resource_profile=PROFILE)

    def test_missing_or_extra_shape_policy_fields_rejected(self):
        high,spec,meta=bound()
        for mutate in (lambda m:m.pop("source_shape_capture"),
                       lambda m:m["source_shape_capture"].update(extra=True)):
            bad=copy.deepcopy(meta);mutate(bad)
            with self.assertRaisesRegex(ValueError,"source shape policy binding"):
                intake.check_capture_metadata(bad,high,spec,resource_profile=PROFILE)

    def test_v8_cannot_claim_new_source_policy(self):
        high,spec,meta=bound();spec["format"]=intake.FORMAT
        with self.assertRaisesRegex(ValueError,"Capture metadata"):
            intake.check_capture_metadata(meta,high,spec,resource_profile=PROFILE)

    def test_reference_versions_cannot_be_interchanged(self):
        high,spec,meta=bound()
        with self.assertRaisesRegex(ValueError,"reference source identity"):
            intake.check_reference(dict(format=intake.REFERENCE_FORMAT),high,{},spec,resource_profile=PROFILE)

    def test_capabilities_register_explicit_new_input_without_execution_claim(self):
        from application_capabilities import input_sources
        declaration=input_sources()["trusted_pytorch"]
        self.assertIn(intake.FORMAT,declaration["formats"])
        self.assertIn(intake.SHAPE_FORMAT,declaration["formats"])
        self.assertEqual(declaration["arithmetic_result_shape"]["policy"],ARITHMETIC_POLICY)
        self.assertEqual(declaration["arithmetic_result_shape"]["encrypted_status"],"unverified")

if __name__=="__main__":unittest.main()
