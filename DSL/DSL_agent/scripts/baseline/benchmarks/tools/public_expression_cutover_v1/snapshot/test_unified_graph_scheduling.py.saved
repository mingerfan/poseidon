import copy
import json
from pathlib import Path
import unittest
import numpy as np
from benchmark_suite import Builder
from benchmark_graph import samples
from benchmark_math import evaluate as mathematical
from benchmark_torch import evaluate as torch_reference
from compiler_configuration import configuration
from unified_graph_contract import prepare, validate_candidate
from unified_graph_lowering import lower
from unified_graph_scheduling import schedule_source
from test_packed_prefix_lowering import public_execute

ROOT = Path(__file__).resolve().parents[2]


def request_for(model):
    config = configuration("poseidon-cpu-eva-w45-v1")
    return prepare(model, config["ckks_config_sha256"], config)


class RuleSchedulingTests(unittest.TestCase):
    def assert_semantics(self, model):
        request = request_for(model)
        before = copy.deepcopy(request)
        original = lower(request)
        source, record = schedule_source(original, request)
        self.assertTrue(record["applied"])
        self.assertLess(record["scheduled_depth_bound"], record["original_depth_bound"])
        self.assertEqual(request, before)
        self.assertEqual((source, record), schedule_source(original, request))
        validate_candidate(dict(schema=1, request_id=request["request_id"], hecate_source=source), request)
        for inputs in samples(model, 16):
            actual = public_execute(source, request, inputs)
            original_outputs = public_execute(original, request, inputs)
            for evaluate in (mathematical, torch_reference):
                expected = evaluate(model, inputs)
                for i, output in enumerate(model["outputs"]):
                    count = np.prod(expected[output["name"]].shape)
                    np.testing.assert_allclose(actual[i][:count], expected[output["name"]].reshape(-1),
                                               rtol=1e-12, atol=1e-12)
                    np.testing.assert_allclose(actual[i][:count], original_outputs[i][:count],
                                               rtol=1e-12, atol=1e-12)
        return source

    def test_unbalanced_multiplication_with_offsets_and_multiple_outputs(self):
        for size in (2, 4, 6):
            b = Builder([(size,), (size,)])
            x, rhs = "input0", "input1"
            deep = b.node("power", [x], exponent=4)
            product = b.node("multiply", [deep, rhs])
            weighted = b.node("multiply", [product, b.const([.25])])
            result = b.node("subtract", [weighted, b.const([.125])])
            self.assert_semantics(b.finish(result, x))

    def test_normalization_contexts_without_model_name_dispatch(self):
        root = ROOT/"scripts/baseline/cases/operator-extension-v5"
        manifest = json.loads((root/"manifest.json").read_text())
        for case in manifest["cases"]:
            if case["operator"] == "matmul":
                continue
            model = json.loads((root/case["model"]).read_text())
            with self.subTest(case=case["id"]):
                source = self.assert_semantics(model)
                renamed = copy.deepcopy(model)
                renamed["id"] = "unseen_model_identity"
                new_request = request_for(renamed)
                self.assertEqual(source, schedule_source(lower(new_request), new_request)[0])

    def test_no_improvement_preserves_exact_source(self):
        b = Builder([(4,)])
        y = b.node("square", ["input0"])
        request = request_for(b.finish(y))
        original = lower(request)
        source, record = schedule_source(original, request)
        self.assertEqual(source, original)
        self.assertFalse(record["applied"])

    def test_masked_public_bias_does_not_leak_to_other_lanes(self):
        b = Builder([(3,), (3,)])
        deep = b.node("power", ["input0"], exponent=4)
        z = b.node("multiply", [deep, "input1"])
        z = b.node("multiply", [z, b.const([-.25])])
        z = b.node("add", [z, b.const([.125, -.25, .5])])
        self.assert_semantics(b.finish(z))

    def test_shared_intermediate_and_output_dependency(self):
        b = Builder([(4,), (4,)])
        deep = b.node("power", ["input0"], exponent=4)
        z = b.node("multiply", [deep, "input1"])
        left = b.node("multiply", [z, b.const([.25])])
        right = b.node("multiply", [z, b.const([-.125])])
        self.assert_semantics(b.finish(left, right, deep))

    def test_cpu_default_uses_schedule_without_changing_request(self):
        from unified_graph_lowering import candidate_source
        path=ROOT/"scripts/baseline/cases/operator-extension-v5/layer_norm_0-model.json"
        request=request_for(json.loads(path.read_text()))
        original=copy.deepcopy(request)
        source,record=candidate_source(request)
        self.assertTrue(record["scheduling"]["applied"])
        self.assertEqual(record["scheduling"]["power_basis_evaluation"],"grouped-power-v1")
        self.assertFalse(record["scheduling"]["provider_candidate_rewritten"])
        self.assertEqual(request,original)
        for inputs in samples(request["model"],16):
            actual=public_execute(source,request,inputs)
            for reference in (mathematical,torch_reference):
                expected=reference(request["model"],inputs)[request["model"]["outputs"][0]["name"]].reshape(-1)
                np.testing.assert_allclose(actual[0][:len(expected)],expected,atol=1e-12,rtol=1e-12)

    def test_historical_configuration_retains_exact_source(self):
        from unified_graph_lowering import candidate_source
        path=ROOT/"scripts/baseline/cases/operator-extension-v5/layer_norm_0-model.json"
        config=configuration("seal-cpu-eva-w45-v1")
        request=prepare(json.loads(path.read_text()),config["ckks_config_sha256"],config)
        source,record=candidate_source(request)
        self.assertEqual(source,lower(request))
        self.assertNotIn("scheduling",record)

    def test_bound_mask_idempotence_and_public_constant_reuse(self):
        b=Builder([(4,)])
        model=b.finish(b.node("square",["input0"]))
        request=request_for(model)
        name=request["layout"]["inputs"][0]["dsl_name"]
        source='@hc.func("c,c")\ndef golden('+name+', zero_ct):\n'
        source+='    v0 = '+name+' * mask0\n    v1 = v0 * mask0\n'
        source+='    v2 = zero_ct + mask1\n    v3 = v1 * v2\n    return [v3]\n'
        result,record=schedule_source(source,request)
        self.assertTrue(record["applied"])
        self.assertEqual(record["removed_duplicate_masks"],1)
        self.assertEqual(record["reused_encrypted_public_values"],1)
        for inputs in samples(model,16):
            np.testing.assert_allclose(public_execute(result,request,inputs),
                public_execute(source,request,inputs),atol=1e-12,rtol=1e-12)

    def test_public_reuse_requires_bound_encrypted_zero(self):
        b=Builder([(4,)])
        request=request_for(b.finish(b.node("square",["input0"])))
        name=request["layout"]["inputs"][0]["dsl_name"]
        source='@hc.func("c,c")\ndef golden('+name+', zero_ct):\n'
        source+='    v0 = zero_ct + mask1\n    v1 = '+name+' * v0\n    return [v1]\n'
        unbound=copy.deepcopy(request);unbound["layout"]["auxiliary_ciphertexts"]=[]
        self.assertEqual(schedule_source(source,unbound)[0],source)
        self.assertTrue(schedule_source(source,request)[1]["applied"])

    def test_power_basis_balancing_uses_only_bound_coefficients(self):
        from unified_graph_lowering import candidate_source
        for size,degree in ((2,3),(3,6),(4,7)):
            b=Builder([(size,)])
            coefficients=[(-1)**i/(i+1) for i in range(degree+1)]
            value=b.node("polynomial",["input0",b.const(coefficients)],basis="power")
            model=b.finish(value)
            request=request_for(model);original=copy.deepcopy(request)
            source,record=candidate_source(request)
            validate_candidate(dict(schema=1,request_id=request["request_id"],hecate_source=source),request)
            self.assertEqual(request,original)
            for inputs in samples(model,16):
                result=public_execute(source,request,inputs)[0][:size]
                for evaluate in (mathematical,torch_reference):
                    expected=evaluate(model,inputs)["output0"].reshape(-1)
                    np.testing.assert_allclose(result,expected,atol=1e-12,rtol=1e-12)

    def test_whole_period_reductions_and_broadcast_composition(self):
        from unified_graph_lowering import candidate_source
        for shape in ((4,), (2,2), (1,2,2)):
            b=Builder([shape])
            squares=b.node("square",["input0"])
            mean=b.node("mean",[squares],axes=list(range(len(shape))),keepdims=True)
            shifted=b.node("add",[mean,b.const([.25])])
            value=b.node("multiply",["input0",shifted])
            model=b.finish(value,mean)
            request=request_for(model);before=copy.deepcopy(request)
            source,record=candidate_source(request)
            self.assertEqual(record["strategy"],"packed-reduction-v1")
            self.assertTrue(record["scheduling"]["whole_period_reductions"])
            self.assertEqual(request,before)
            for inputs in samples(model,16):
                result=public_execute(source,request,inputs)
                for evaluate in (mathematical,torch_reference):
                    expected=evaluate(model,inputs)
                    for index,output in enumerate(model["outputs"]):
                        target=expected[output["name"]].reshape(-1)
                        np.testing.assert_allclose(result[index][:len(target)],target,atol=1e-12,rtol=1e-12)

    def test_partial_axis_and_tail_reductions_fall_back(self):
        from unified_graph_lowering import has_packed_reduction
        for shape,axes in (((3,),[0]), ((2,2),[1]), ((2,3),[0,1])):
            b=Builder([shape]);mean=b.node("mean",["input0"],axes=axes,keepdims=True)
            model=b.finish(mean);request=request_for(model)
            self.assertFalse(has_packed_reduction(request))
            source=lower(request,packed_prefix=True,packed_reductions=True)
            for inputs in samples(model,16):
                actual=public_execute(source,request,inputs)[0]
                expected=mathematical(model,inputs)["output0"].reshape(-1)
                np.testing.assert_allclose(actual[:len(expected)],expected,atol=1e-12,rtol=1e-12)

    def test_original_whole_model_defaults_keep_two_references(self):
        from unified_graph_lowering import candidate_source
        root=ROOT/"scripts/baseline/cases/poseidon-whole-models-v1"
        for name in ("mlp","rmsnorm","attention_decode"):
            model=json.loads((root/(name+".json")).read_text())
            request=request_for(model);before=copy.deepcopy(request)
            source,record=candidate_source(request)
            validate_candidate(dict(schema=1,request_id=request["request_id"],hecate_source=source),request)
            self.assertEqual(request,before)
            for inputs in samples(model,16):
                actual=public_execute(source,request,inputs)
                for evaluate in (mathematical,torch_reference):
                    expected=evaluate(model,inputs)
                    for i,output in enumerate(model["outputs"]):
                        value=expected[output["name"]].reshape(-1)
                        np.testing.assert_allclose(actual[i][:len(value)],value,atol=1e-12,rtol=1e-12)

    def test_common_encrypted_product_across_shared_branches(self):
        for size in (2,3,4):
            b=Builder([(size,), (size,)])
            shared=b.node("square",["input1"])
            a=b.node("multiply",["input0",shared])
            v=b.node("negate",["input0"])
            z=b.node("multiply",[v,shared])
            result=b.node("add",[a,z])
            model=b.finish(result,shared)
            request=request_for(model)
            source,record=schedule_source(lower(request),request)
            self.assertTrue(record["applied"])
            self.assertGreater(record["factored_common_ciphertext_products"],0)
            validate_candidate(dict(schema=1,request_id=request["request_id"],hecate_source=source),request)
            for inputs in samples(model,16):
                actual=public_execute(source,request,inputs)
                expected=mathematical(model,inputs)
                for i,out in enumerate(model["outputs"]):
                    value=expected[out["name"]].reshape(-1)
                    np.testing.assert_allclose(actual[i][:len(value)],value,atol=1e-12,rtol=1e-12)

    def test_plaintext_rotation_rejected(self):
        b = Builder([(4,)])
        request = request_for(b.finish(b.node("square", ["input0"])))
        source = '@hc.func("c,c")\ndef golden(input0, zero_ct):\n    v0 = mask0.rotate(1)\n    return [v0]\n'
        source = source.replace("input0", request["layout"]["inputs"][0]["dsl_name"])
        with self.assertRaisesRegex(ValueError, "encrypted rotation"):
            schedule_source(source, request)

    def test_side_effect_and_rebinding_rejected(self):
        b = Builder([(4,)])
        request = request_for(b.finish(b.node("square", ["input0"])))
        for body in ("    v0 = open(input0)\n", "    input0 = input0\n"):
            source = '@hc.func("c,c")\ndef golden(input0, zero_ct):\n'+body+'    return [input0]\n'
            source = source.replace("input0", request["layout"]["inputs"][0]["dsl_name"])
            with self.assertRaisesRegex(ValueError, "expression|single assignment"):
                schedule_source(source, request)

    def test_budget_is_not_expanded(self):
        b = Builder([(4,)])
        request = request_for(b.finish(b.node("square", ["input0"])))
        source = '@hc.func("c,c")\ndef golden(input0, zero_ct):\n'
        source += "".join("    v"+str(i)+" = "+("input0" if i == 0 else "v"+str(i-1))+" + mask0\n"
                          for i in range(1025))
        source += "    return [v1024]\n"
        source = source.replace("input0", request["layout"]["inputs"][0]["dsl_name"])
        with self.assertRaisesRegex(ValueError, "operation budget"):
            schedule_source(source, request)


if __name__ == "__main__":
    unittest.main()
