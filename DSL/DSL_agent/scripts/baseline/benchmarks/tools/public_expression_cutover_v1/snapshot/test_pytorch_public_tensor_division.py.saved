"""Explicit source versions, direct divisor boundaries and trusted payload bindings."""
import math,struct,unittest
from pytorch_public_tensor_division import plan
from pytorch_ordered_contract import package_version,reference_version,shim
from pytorch_model_intake import ordered
class PublicDivisorTests(unittest.TestCase):
 def test_nonuniform_signed_channel(self):
  p,raw=plan([2,3],[3],struct.pack("<3d",.5,-2,3))
  self.assertEqual(p["result_shape"],[2,3])
  self.assertEqual(struct.unpack("<3d",raw),(2.,-.5,1/3))
 def test_scalar_compatibility(self):
  p,raw=plan([3],[],struct.pack("<d",2))
  self.assertEqual(p["divisor_shape"],[]);self.assertEqual(struct.unpack("<d",raw),(.5,))
 def test_inplace_shape_preserved(self):
  p,_=plan([2,3],[3],struct.pack("<3d",1,2,4),inplace=True)
  self.assertTrue(p["inplace"])
 def test_inplace_expansion_rejected(self):
  with self.assertRaisesRegex(ValueError,"expand"):plan([2,1],[3],struct.pack("<3d",1,2,3),inplace=True)
 def test_invalid_values_rejected(self):
  for value in (0.,math.inf,math.nan,2048.,1/2048):
   with self.subTest(value=value),self.assertRaises(ValueError):plan([2],[],struct.pack("<d",value))
 def test_invalid_broadcast_rejected(self):
  with self.assertRaisesRegex(ValueError,"broadcast"):plan([2,3],[2],struct.pack("<2d",1,2))
 def test_payload_size_rejected(self):
  with self.assertRaisesRegex(ValueError,"payload"):plan([3],[3],struct.pack("<d",1))
 def test_v22_is_explicit_with_separate_package(self):
  s={"format":"poseidon-trusted-pytorch-v22"}
  self.assertTrue(ordered(s));self.assertEqual(package_version(s),"poseidon-trusted-pytorch-provenance-v22")
  self.assertEqual(reference_version(s),"poseidon-trusted-pytorch-reference-v22")
  self.assertEqual(shim(s)["format"],"poseidon-trusted-pytorch-v7")
 def test_old_v21_identity_retained(self):
  s={"format":"poseidon-trusted-pytorch-v21"}
  self.assertEqual(package_version(s),"poseidon-trusted-pytorch-provenance-v21")
  self.assertEqual(reference_version(s),"poseidon-trusted-pytorch-reference-v21")
 def test_unknown_version_rejected(self):
  with self.assertRaises(ValueError):package_version({"format":"poseidon-trusted-pytorch-v23"})
