{
  "public_left_spatial": {
    "constants": {
      "offset": [
        [
          [
            0.5,
            0.5
          ]
        ]
      ]
    },
    "format": "poseidon-operator-graph-v4",
    "id": "public_left_spatial",
    "inputs": [
      {
        "name": "x",
        "shape": [
          1,
          1,
          2
        ]
      }
    ],
    "nodes": [
      {
        "attrs": {},
        "id": "public_shift",
        "inputs": [
          "offset",
          "x"
        ],
        "op": "subtract",
        "outputs": [
          "shifted"
        ]
      },
      {
        "attrs": {
          "align_corners": null,
          "antialias": false,
          "mode": "nearest",
          "recompute_scale_factor": null,
          "scale_factor": null,
          "size": [
            4
          ]
        },
        "id": "resize",
        "inputs": [
          "shifted"
        ],
        "op": "resize",
        "outputs": [
          "resize_value"
        ]
      },
      {
        "attrs": {
          "approximation": {
            "degree": 1,
            "domain": [
              -1.0,
              1.0
            ],
            "method": "taylor"
          }
        },
        "id": "activation",
        "inputs": [
          "resize_value"
        ],
        "op": "exp",
        "outputs": [
          "y"
        ]
      }
    ],
    "outputs": [
      {
        "name": "out",
        "value": "y"
      }
    ]
  },
