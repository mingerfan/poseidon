from scope import ROOT,BASE,HERE,PROPOSAL,CASES,PROVIDER,BUDGET,read,sha,digest,require,verify
sys.path.insert(0,str(BASE))
from public_weight_context import project
from candidate_contract import request_file_bytes
OUT=pathlib.Path("/home/lhohy/poseidon-work/platforms/aarch64-linux/results/agent-einsum-source-acceptance-v2")
