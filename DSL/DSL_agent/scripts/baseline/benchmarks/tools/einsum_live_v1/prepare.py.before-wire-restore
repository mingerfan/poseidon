  require(request["request_id"]==row["request_id"],"qualified_request")
  item=dict(id=row["case"],source_manifest=str(fixture),source_manifest_sha256=sha(fixture),
    source_format=spec["format"],source_files={str((fixture.parent/n).relative_to(ROOT)):h
