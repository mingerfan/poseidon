    options=dict(generation_guidance="explicit-v13",public_weight_policy="descriptors-math-roles-v2",chunk_period=4))
  rows.append(item)
 value=dict(format="poseidon-einsum-live-proposal-v1",revision="r1341",approved=False,executed=False,
  development_checkout=str(ROOT),branch="lhy-agent-dsl",platform="aarch64-linux",
  source_stage_identity=identity,identity_sha256=identity["manifest_sha256"],
  preparation_origin="immutable eight already-captured numerical-accepted task requests; data only",
  baseline_report=str(OUT/"report.json"),baseline_report_sha256=sha(OUT/"report.json"),
  baseline_report_binding=report["binding"],cases=rows,provider=PROVIDER,budget=BUDGET,
  validation=["source_capture_and_frozen_request_match","real_agent_generation","true_compile","artifact_integrity",
