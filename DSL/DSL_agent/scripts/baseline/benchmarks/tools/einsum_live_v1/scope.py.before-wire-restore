"""Immutable eight-case live scope; planning and integrity checks never call an API."""
import argparse,hashlib,json,pathlib
HERE=pathlib.Path(__file__).resolve().parent
ROOT=HERE.parents[4];BASE=ROOT/"scripts/baseline"
PROPOSAL=ROOT/"docs/baseline/agent-einsum-live-proposal-r1341.json"
CASES=("einsum_matrix","einsum_heads","einsum_contraction_broadcast","einsum_three",
       "einsum_four","einsum_public_weight","einsum_view_mutation","einsum_partition_composition")
PROVIDER=dict(name="deepseek",model="deepseek-flash",reasoning_effort="high",stream=True,
              timeout_seconds=1200,max_tokens=384000,transport_retries=3)
BUDGET=dict(max_generations=32,max_http_attempts=128,max_repairs=3,
 api_concurrency=1,native_concurrency=1,compile_jobs=2,link_jobs=1,
 batch_wall_seconds=43200,case_wall_seconds=14400,new_batch_bytes=4*1024**3,
 per_case_bytes=4*1024**3,global_result_bytes=32*1024**3,reserve_bytes=4*1024**3,
 native_address_bytes=4*1024**3,native_cpu_seconds=150,currency_limit=None)
def require(ok,code):
 if not ok:raise ValueError(code)
def read(p):return json.loads(pathlib.Path(p).read_text())
def sha(p):return hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest()
def digest(v):return hashlib.sha256(json.dumps(v,sort_keys=True,separators=(",",":"),allow_nan=False).encode()).hexdigest()
def rooted(p,root):
 p=pathlib.Path(p)
 require(p.is_absolute()and p==p.resolve()and p.is_relative_to(root)
         and p.is_file()and not any(v.is_symlink()for v in(p,*p.parents)),"frozen_file_path")
 return p
def fields(value):
 require(type(value)is dict and value.get("format")=="poseidon-einsum-live-proposal-v1","proposal_format")
 require(value.get("binding")==digest({k:v for k,v in value.items()if k!="binding"}),"proposal_binding")
 require(value.get("approved")is False and value.get("executed")is False,"planning_is_not_authorization")
 require(value.get("provider")==PROVIDER and value.get("budget")==BUDGET,"reviewed_budget")
 require(value.get("previous_unknown_http_retried")is False,"unknown_call_not_retried")
 cases=value.get("cases")
 require(type(cases)is list and tuple(c.get("id")for c in cases)==CASES,"reviewed_cases")
 require(len({c.get("request_id")for c in cases})==8,"unique_requests")
 for c in cases:
  require(c.get("source_format")=="poseidon-trusted-pytorch-v18"and c.get("validation_level")=="numerical"
    and c.get("max_generations")==4 and c.get("max_http_attempts")==16 and c.get("max_repairs")==3,
    "case_contract")
  require(type(c.get("public_context_bytes"))is int and 0<c["public_context_bytes"]<=131072,"context_budget")
 require(value.get("provider_calls")==value.get("compiler_calls")==value.get("encrypted_calls")==0,
         "data_freeze_only")
 return value
def verify(value,*,root=ROOT,base=BASE,check_tools=True):
 fields(value);root=pathlib.Path(root);base=pathlib.Path(base)
 require(value["development_checkout"]==str(root)and value["branch"]=="lhy-agent-dsl","checkout_scope")
 require(value["platform"]=="aarch64-linux","reviewed_platform")
 identity=value["source_stage_identity"]
 require(identity["manifest_sha256"]==value["identity_sha256"],"identity_reference")
 for stage in("generation","compilation","execution","validation"):
  for name,h in identity[stage]["sources"].items():
   require(sha(rooted(base/name,root))==h,"source_identity_changed")
  for name,h in identity[stage]["configuration_files"].items():
   require(sha(rooted(root/name,root))==h,"configuration_changed")
 for c in value["cases"]:
  require(sha(rooted(c["source_manifest"],root))==c["source_manifest_sha256"],"source_manifest_changed")
  for name,h in {**c["source_files"],**c["weight_files"]}.items():
   require(sha(rooted(root/name,root))==h,"source_or_weight_changed")
  for name in("full_request_file","public_request_file"):
   path=rooted(c[name],root)
   require(sha(path)==c[name+"_sha256"],"frozen_request_changed")
  full=read(c["full_request_file"]);public=read(c["public_request_file"])
  require(full["request_id"]==public["request_id"]==c["request_id"],"request_identity")
  require(digest({k:v for k,v in public.items()if k!="request_id"})==c["request_id"],"public_request_binding")
  require(pathlib.Path(c["public_request_file"]).stat().st_size==c["public_context_bytes"],"context_size")
 if check_tools:
  for name,h in value["preparation_tools"].items():
   require(sha(rooted(root/name,root))==h,"preparation_tool_changed")
 return dict(format="poseidon-einsum-live-plan-v1",proposal_binding=value["binding"],
  approved=False,executed=False,cases=list(CASES),provider=PROVIDER,budget=BUDGET,
  identity_sha256=value["identity_sha256"],provider_calls=0,
  native_generation=0,real_execution_requires_current_runtime_identity=True,
  status="prepared_waiting_for_separate_approval")
def main():
 parser=argparse.ArgumentParser(description=__doc__);parser.add_argument("--plan",action="store_true",required=True)
 parser.parse_args();print(json.dumps(verify(read(PROPOSAL)),ensure_ascii=False,sort_keys=True))
if __name__=="__main__":main()
