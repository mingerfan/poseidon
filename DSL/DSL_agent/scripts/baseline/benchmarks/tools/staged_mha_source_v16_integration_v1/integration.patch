+        kw=np.asarray(p["k_proj_weight"],dtype=np.float64);vw=np.asarray(p["v_proj_weight"],dtype=np.float64)
+    bias=None if p["in_proj_bias"] is None else np.asarray(p["in_proj_bias"],dtype=np.float64)
