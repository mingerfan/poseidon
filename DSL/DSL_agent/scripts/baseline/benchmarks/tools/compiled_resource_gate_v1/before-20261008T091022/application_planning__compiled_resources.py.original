"""Checked, optional resource facts for a compiled Poseidon program.

The fixed CPU Runtime retains all definitions for a sample. This adapter reports
their coefficient payload, not allocator capacity, keys, workspace or peak RSS.
It does not generate, compile, execute, or alter a program.
"""
import copy
import hashlib
import json
from collections import Counter
from pathlib import Path

FORMAT = "poseidon-compiled-resource-analysis-v1"
POLICY = "fixed-cpu-retained-coefficients-v1"
ROOT = Path(__file__).resolve().parents[3]
POLICY_FILE = "application_planning/compiled-resource-policy-v1.json"
BASIS = (
    "third_party/ckks-runtime-agent/runtime/runtime.hpp",
    "src/poseidon/runtime_api/poseidon_cpu_api.h",
    "src/poseidon/runtime_api/poseidon_cpu_api.cpp",
    "src/poseidon/tools/agent_runtime/cpu_runner.cpp",
    "src/poseidon/tools/agent_runtime/CMakeLists.txt",
    "src/poseidon/ciphertext.cpp", "src/poseidon/ciphertext.h",
    "src/poseidon/plaintext.h", "src/poseidon/plaintext.cpp",
    "src/poseidon/ckks_encoder.h", "src/poseidon/ckks_encoder.cpp",
    "src/poseidon/crt_context.cpp",
)

def require(ok, code):
    if not ok:
        raise ValueError(code)

def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def source_authority():
    from application_identity import source_closure, POLICY as authority_policy
    closure = source_closure(ROOT / "scripts/baseline",
                             ("application_planning/compiled_resources.py",))
    return dict(policy=authority_policy, sha256=sha(canonical(closure)),
                sources=closure["sources"])

def _basis():
    from model_weight_package import regular_bytes
    from candidate_contract import strict_json
    raw = regular_bytes(ROOT / "scripts/baseline" / POLICY_FILE, 16384)
    policy = strict_json(raw.decode())
    require(type(policy) is dict and set(policy) == {
        "format", "policy", "retention", "word_bytes", "source_basis_sha256"},
        "compiled_resource_policy_fields")
    require(policy["format"] == "poseidon-compiled-resource-policy-v1" and
            policy["policy"] == POLICY and policy["word_bytes"] == 8 and
            policy["retention"] == "all_defined_values_until_runtime_destruction" and
            set(policy["source_basis_sha256"]) == set(BASIS),
            "compiled_resource_policy_unverified")
    for name, expected in policy["source_basis_sha256"].items():
        require(sha(regular_bytes(ROOT / name, 2 * 1024**2)) == expected,
                "compiled_resource_source_basis_changed")
    return dict(policy_sha256=sha(raw), **policy)

def _measure_plan(plan, degree, budget, payload_lengths):
    """Arithmetic over an already checked plan; no evaluation of CKKS operators."""
    require(type(degree) is int and degree > 0 and type(budget) is int and budget > 0,
            "compiled_resource_measure_parameters")
    values = {v["id"]: v for v in plan["values"]}
    require(len(values) == len(plan["values"]), "compiled_resource_duplicate_value")
    live = set()
    rows = []
    words = Counter()
    counts = Counter()
    ordinal_set = set()
    operations = Counter()
    rotations = set()
    relin = False

    # The fixed loader retains one decoded slot vector per content used by
    # initialization. Identical payloads can be encoded into different objects.
    contents = {}
    inline_slots = 0
    for phase in ("initialization", "execution"):
        for operation in plan[phase]:
            if operation["kind"] != "encode":
                continue
            payload = operation["payload"]
            if payload["kind"] == "inline":
                inline_slots += len(payload["values"])
            elif phase == "initialization":
                content = payload["content"]
                require(content in payload_lengths, "compiled_resource_bundle_length")
                length = payload_lengths[content]
                require(type(length) is int and 0 < length <= degree // 2,
                        "compiled_resource_bundle_length")
                contents[content] = length
    slot_bytes = 8 * (inline_slots + sum(contents.values()))

    def define(value_id, phase, ordinal):
        require(value_id in values and value_id not in live, "compiled_resource_definition")
        v = values[value_id]
        require(v["kind"] in ("ciphertext", "plaintext") and
                type(v["level"]) is int and 0 <= v["level"] <= 12 and
                type(v["components"]) is int and 1 <= v["components"] <= 3 and
                (v["kind"] != "plaintext" or v["components"] == 1),
                "compiled_resource_value_metadata")
        size = degree * (v["level"] + 1) * v["components"] * 8
        words[v["kind"]] += size
        counts[v["kind"]] += 1
        live.add(value_id)
        rows.append(dict(phase=phase, ordinal=ordinal, value=value_id, kind=v["kind"],
                         level=v["level"], components=v["components"],
                         coefficient_payload_bytes=size,
                         retained_coefficient_payload_bytes=sum(words.values()),
                         known_retained_payload_lower_bytes=sum(words.values()) + slot_bytes))

    for value_id in plan["external_inputs"]:
        define(value_id, "external_inputs", None)
    for phase in ("initialization", "execution"):
        for operation in plan[phase]:
            ordinal = operation["ordinal"]
            require(ordinal not in ordinal_set, "compiled_resource_duplicate_ordinal")
            ordinal_set.add(ordinal)
            if operation["kind"] == "compute":
                require(all(s in live for s in operation["inputs"]),
                        "compiled_resource_undefined_input")
                op = operation["op"]
                operations[op] += 1
                relin |= op == "relinearize"
                if op == "rotate":
                    rotations.add(operation["attrs"]["steps"])
            else:
                require(operation["kind"] == "encode", "compiled_resource_instruction")
            define(operation["output"], phase, ordinal)
    require(not plan["finalization"] and
            all(v in live and values[v]["kind"] == "ciphertext" for v in plan["final_outputs"]),
            "compiled_resource_final_outputs")
    total = sum(words.values())
    lower = total + slot_bytes
    exceeded = next((r for r in rows if r["known_retained_payload_lower_bytes"] > budget), None)
    output_ids = set(plan["final_outputs"])
    return dict(
        definitions=dict(ciphertext=counts["ciphertext"], plaintext=counts["plaintext"],
                         total=len(live), unallocated_declarations=len(values) - len(live)),
        output_declarations=len(plan["final_outputs"]), output_objects=len(output_ids),
        operations=dict(sorted(operations.items())),
        evaluation_keys=dict(relinearization_required=relin,
                             requested_rotation_steps=sorted(rotations)),
        schedule=dict(minimum_defined_level=min(values[v]["level"] for v in live),
                      final_output_levels=[values[v]["level"] for v in plan["final_outputs"]],
                      maximum_declared_scale_log2=max(values[v]["scale_log2"] for v in live),
                      rescale_operations=operations["rescale"],
                      modswitch_operations=operations["mod_switch"]),
        retained_ciphertext_coefficient_bytes=words["ciphertext"],
        retained_plaintext_coefficient_bytes=words["plaintext"],
        retained_coefficient_payload_bytes=total,
        retained_bundle_slot_vectors=len(contents),
        retained_plain_slot_payload_bytes=slot_bytes,
        known_retained_payload_lower_bytes=lower,
        first_exceeding_definition=exceeded,
        definitions_in_order=rows,
    )

def _load_plan(path, expected_sha256=None):
    # RuntimePlan uses the existing artifact protocol, not the model response bound.
    from poseidon_artifact_gate import read, json_read
    raw = read(path, limit=16 * 1024**2)
    require(expected_sha256 is None or sha(raw) == expected_sha256,
            "compiled_resource_artifact_snapshot_changed")
    return raw, json_read(raw)

def analyze_program(folder, *, memory_budget_bytes=None):
    """Audit a reloadable CPU package and return a bound, request-specific estimate."""
    from candidate_bundle import check_execution_dependencies
    from model_weight_package import regular_bytes
    from candidate_contract import strict_json
    from poseidon_backend_identity import identity
    from poseidon_runtime_compile import audit_entrypoint
    from poseidon_validation import audit_gate
    from poseidon_artifact_gate import payload_values
    from application_planning.resources import native_address_limit, parameters

    folder = Path(folder)
    authority = source_authority()
    basis = _basis()
    manifest, request = check_execution_dependencies(folder)
    start_identity = identity()
    artifacts = folder / "artifacts"
    _, validation = _load_plan(artifacts / "validation.json",
                               manifest["files"]["artifacts/validation.json"])
    audit_entrypoint(artifacts, request, validation.get("runtime_plan_entry"),
                     validation.get("compile_command"))
    audit_gate(artifacts, request, validation["gate"])
    ceiling = native_address_limit()
    require(memory_budget_bytes is None or type(memory_budget_bytes) is int and
            1 <= memory_budget_bytes <= ceiling, "compiled_resource_memory_budget")
    budget = ceiling if memory_budget_bytes is None else memory_budget_bytes
    params = parameters(request)
    plan_raw, plan = _load_plan(artifacts / "bound/plan.json",
                               manifest["files"]["artifacts/bound/plan.json"])
    payload_lengths = {}
    for operation in plan["initialization"]:
        if operation["kind"] == "encode" and operation["payload"]["kind"] == "bundle":
            payload_lengths[operation["payload"]["content"]] = len(
                payload_values(plan, operation, artifacts / "bound/bundle"))
    facts = _measure_plan(plan, params["poly_degree"], budget, payload_lengths)
    floor = facts["known_retained_payload_lower_bytes"]
    require(facts["definitions"]["ciphertext"] > 0, "compiled_resource_ciphertext_definitions")
    location = facts["first_exceeding_definition"]
    failure = None
    if floor > budget:
        failure = dict(layer="resource", code="compiled_retained_payload_exceeds_budget",
                       location=None if location is None else
                       {k: location[k] for k in ("phase", "ordinal", "value")},
                       context=dict(required_lower_bytes=floor, budget_bytes=budget))
    resources = dict(
        retained_coefficient_payload_bytes=dict(value=facts["retained_coefficient_payload_bytes"],
            certainty="exact", scope="defined polynomial coefficients; not allocation capacity"),
        known_retained_payload_lower_bytes=dict(value=floor, certainty="conservative",
            bound="lower", scope="per-sample retained coefficients and loaded slot-vector payload"),
        evaluation_key_bytes=dict(value=None, certainty="unknown"),
        allocator_capacity_bytes=dict(value=None, certainty="unknown"),
        evaluator_workspace_bytes=dict(value=None, certainty="unknown"),
        peak_memory_bytes=dict(value=None, certainty="unknown"),
        execution_seconds=dict(value=None, certainty="unknown"),
    )
    value = dict(format=FORMAT, policy=POLICY,
        status="blocked" if failure else "assessed", failure=failure,
        request_id=request["request_id"], request_sha256=sha(canonical(request)),
        bundle_binding=manifest["binding"], plan_sha256=sha(plan_raw),
        backend="poseidon_cpu", backend_identity=start_identity,
        source_authority=authority, source_basis=basis, parameters=params,
        facts=facts, resources=resources,
        requested_memory_budget_bytes=memory_budget_bytes,
        limits=dict(memory_budget_bytes=budget, native_address_limit=ceiling,
                    memory_budget_scope="retained_payload_precheck",
                    requested_budget_applied_to_runtime=False),
        package_validation=copy.deepcopy(manifest["validation"]),
        execution_readiness="unknown", compiled_artifacts_checked=True,
        compilation_performed=False, encrypted_execution=False,
        paid_calls=0, claim="A fitting storage lower bound does not certify peak memory or execution.")
    value["binding"] = sha(canonical(value))
    require(check_execution_dependencies(folder)[0] == manifest and
            identity() == start_identity and _basis() == basis and
            source_authority() == authority, "compiled_resource_identity_drift")
    return value

def check_analysis(value, folder):
    require(type(value) is dict and value.get("format") == FORMAT and value.get("policy") == POLICY,
            "compiled_resource_analysis_format")
    require(value.get("binding") == sha(canonical({k: v for k, v in value.items() if k != "binding"})),
            "compiled_resource_analysis_binding")
    expected = analyze_program(folder, memory_budget_bytes=value["requested_memory_budget_bytes"])
    require(canonical(value) == canonical(expected), "compiled_resource_analysis_changed")
    return value

def require_storage_precheck(value, folder):
    """Require the storage precheck; it does not set or certify peak memory."""
    check_analysis(value, folder)
    require(value["status"] == "assessed", "compiled_resource_execution_blocked")
    return value


# Retain the initial host-call spelling with the same precheck-only semantics.
require_execution_budget = require_storage_precheck
