{
  "constants": {},
  "format": "poseidon-operator-graph-v1",
  "id": "spatial_composition_1",
  "inputs": [
    {
      "name": "x",
      "shape": [
        1,
        2,
        4
      ]
    }
  ],
  "nodes": [
    {
      "attrs": {
        "align_corners": false,
        "antialias": false,
        "mode": "linear",
        "recompute_scale_factor": true,
        "scale_factor": [
          1.15
        ],
        "size": null
      },
      "id": "resize",
      "inputs": [
        "x"
      ],
      "op": "resize",
      "outputs": [
        "y"
      ]
    },
    {
      "attrs": {
        "axes": [
          2
        ],
        "keepdims": true
      },
      "id": "reduce",
      "inputs": [
        "y"
      ],
      "op": "mean",
      "outputs": [
        "reduced"
      ]
    }
  ],
  "outputs": [
    {
      "name": "original",
      "value": "y"
    },
    {
      "name": "composed",
      "value": "reduced"
    }
  ]
}
