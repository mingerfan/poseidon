+                  all(x is None or type(x) is int for x in (item["start"],item["stop"],item["step"])) and
+                  (item["step"] is None or item["step"] > 0), "alias_shape_rejected",position)
+            result.append(slice(item["start"],item["stop"],item["step"]))
+        elif kind == "int":
