"""Bound production control report; no Provider, compiler or FHE entry."""
import argparse,hashlib,json,sys,unittest
from pathlib import Path
HERE=Path(__file__).resolve().parent
ROOT=HERE.parents[4];BASE=ROOT/"scripts/baseline"
sys.path.insert(0,str(HERE))
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def canonical(v):return json.dumps(v,sort_keys=True,separators=(",",":"),allow_nan=False).encode()
if __name__=="__main__":
    parser=argparse.ArgumentParser()
    parser.add_argument("--report",type=Path,required=True)
    args=parser.parse_args()
    if args.report.exists():raise ValueError("fresh_control_report_required")
    suite=unittest.defaultTestLoader.loadTestsFromName("test_production")
    count=suite.countTestCases()
    result=unittest.TextTestRunner(stream=sys.stdout,verbosity=2).run(suite)
    value=dict(format="poseidon-public-math-production-controls-v1",planned=count,
      passed=result.testsRun-len(result.errors)-len(result.failures)-len(result.skipped),
      failed=len(result.failures),errors=len(result.errors),skipped=len(result.skipped),
      test_ids=dict(failures=[x.id() for x,_ in result.failures],errors=[x.id() for x,_ in result.errors]),
      provenance_fixture="retained historical isolated source capture; real admission checks without new capture",
      provider_calls=0,http_attempts=0,compiler_calls=0,encrypted_executions=0,
      capture_supervisor_calls=0,backend="identity fixture, operations forbidden",production_imports=True,
      source_files={str(p.relative_to(ROOT)):sha(p) for p in
       [HERE/"test_production.py",HERE/"production_test_runner.py"]+
       [BASE/n for n in ("public_math_context.py","public_weight_context.py","component_contract.py",
        "deepseek_provider.py","run_candidate.py","application_component.py","application_model_source.py",
        "unified_graph_contract.py")]})
    value["binding"]=hashlib.sha256(canonical(value)).hexdigest()
    args.report.write_bytes(canonical(value))
    print(json.dumps({k:value[k] for k in ("format","planned","passed","failed","errors","skipped","binding","provider_calls","compiler_calls","encrypted_executions")},sort_keys=True))
    raise SystemExit(0 if result.wasSuccessful() else 1)
