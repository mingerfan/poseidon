+// Statically inline the already traced straight-line body. Earth/HEVM has no
+// runtime call instruction; cloning IR preserves every operand/result without
+// re-executing the user's Python function at each call site.
+size_t createCall(Context *ctxt, funcID fun, valueID *args, size_t nargs,
+                  valueID *results, size_t capacity, char *, size_t) {
+  const auto invalid = std::numeric_limits<size_t>::max();
+  if (fun >= ctxt->funcMap.size() || !ctxt->builder->getInsertionBlock())
+    return invalid;
+  auto callee = ctxt->funcMap[fun];
+  if (callee.empty() || !llvm::hasSingleElement(callee.getBody()) ||
+      nargs != callee.getNumArguments() || capacity != callee.getNumResults() ||
+      mlir::failed(mlir::verify(callee)))
+    return invalid;
+  auto &body = callee.front();
+  auto returned = mlir::dyn_cast<mlir::func::ReturnOp>(body.getTerminator());
+  if (!returned || returned.getNumOperands() != capacity)
+    return invalid;
+  mlir::IRMapping mapping;
+  for (size_t i = 0; i < nargs; ++i) {
+    if (args[i] >= ctxt->valueMap.size() ||
+        ctxt->valueMap[args[i]].getParentBlock() != ctxt->builder->getInsertionBlock() ||
+        ctxt->valueMap[args[i]].getType() != body.getArgument(i).getType())
+      return invalid;
+    mapping.map(body.getArgument(i), ctxt->valueMap[args[i]]);
+  }
+  for (auto &op : body.without_terminator())
+    ctxt->builder->clone(op, mapping);
+  for (size_t i = 0; i < capacity; ++i) {
+    ctxt->valueMap.push_back(mapping.lookup(returned.getOperand(i)));
+    results[i] = ctxt->valueMap.size() - 1;
+  }
+  return capacity;
 }
 
