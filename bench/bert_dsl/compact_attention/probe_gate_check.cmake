# CPU-only parser/authorization tests. NEVER pass --run-gpu here.
if(NOT DEFINED PROBE)
    message(FATAL_ERROR "PROBE executable is required")
endif()
foreach(mode IN ITEMS baseline paired packed packed_binary)
    set(args)
    if(mode STREQUAL paired)
        list(APPEND args --pair-products)
    elseif(mode STREQUAL packed OR mode STREQUAL packed_binary)
        list(APPEND args --pack-inputs)
    endif()
    if(mode STREQUAL packed_binary)
        list(APPEND args --key-policy binary)
    endif()
    execute_process(COMMAND "${PROBE}" ${args} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT "${code}" STREQUAL "2")
        message(FATAL_ERROR "${mode} unauthorized gate returned ${code}, expected2: ${out}${err}")
    endif()
endforeach()
execute_process(COMMAND "${PROBE}" --pair-products --pack-inputs
    RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT "${code}" STREQUAL "1" OR NOT err MATCHES "mutually exclusive")
    message(FATAL_ERROR "conflicting modes did not fail explicitly before CUDA: ${code}: ${out}${err}")
endif()
message(STATUS "PASS CPU-only unauthorized baseline/paired/packed/binary gates and mutually-exclusive flags")
