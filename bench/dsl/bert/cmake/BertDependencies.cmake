include_guard(GLOBAL)
include(CMakeParseArguments)

get_filename_component(_bert_default_poseidon_root "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
set(POSEIDON_ROOT "${_bert_default_poseidon_root}" CACHE PATH "Poseidon source tree")
set(POSEIDON_CKKS_RUNTIME_SOURCE_DIR "${POSEIDON_ROOT}/third_party/ckks-runtime" CACHE PATH "CKKS Runtime source tree")
set(BERT_DEPENDENCY_MODE AUTO CACHE STRING "Dependency mode: AUTO, SOURCE, or PREBUILT")
set_property(CACHE BERT_DEPENDENCY_MODE PROPERTY STRINGS AUTO SOURCE PREBUILT)
set(BERT_PREBUILT_BUILD "" CACHE PATH "Explicit compatible Poseidon build tree (no machine-specific default)")
set(BERT_CONFIG_INCLUDE_DIR "" CACHE PATH "Directory containing the matching generated poseidon/util/config.h")
foreach(_bert_library IN ITEMS CPU GPU API CORE JSON)
    set(BERT_${_bert_library}_LIBRARY "" CACHE FILEPATH "Optional explicit compatible ${_bert_library} library")
endforeach()
set(BERT_PREBUILT_CPU_LIBRARY "" CACHE FILEPATH "Optional compatible CPU library for SOURCE mode; GPU and Runtime are rebuilt")
option(BERT_PREBUILT_WITH_NCCL_MPI "Imported GPU API requires MPI/NCCL" OFF)
option(BERT_BUILD_TESTS "Build/register CPU checks and device-free probe CLI checks" ON)

# Respect both standard CMake architecture selection and CUDAARCHS. A portable
# explicit fallback avoids compiler identification querying a local GPU. Select
# another SM (or list of SMs) with -DCMAKE_CUDA_ARCHITECTURES=... for the target.
macro(bert_default_cuda_architectures)
    if(NOT DEFINED CMAKE_CUDA_ARCHITECTURES AND "$ENV{CUDAARCHS}" STREQUAL "")
        set(CMAKE_CUDA_ARCHITECTURES 75 CACHE STRING "Target CUDA architectures (never auto-detect a device)")
    endif()
endmacro()

# Preserve the old per-engine override names, but never fill them with paths to
# a private machine. Each standalone entry can still use an explicit old bundle.
macro(bert_module_paths prefix)
    set(${prefix}_POSEIDON_ROOT "${POSEIDON_ROOT}" CACHE PATH "Matching Poseidon source tree")
    set(${prefix}_PREBUILT_BUILD "${BERT_PREBUILT_BUILD}" CACHE PATH "Explicit matching dependency build tree")
    set(${prefix}_CPU_LIBRARY "${BERT_CPU_LIBRARY}" CACHE FILEPATH "Explicit matching CPU library")
    set(${prefix}_GPU_LIBRARY "${BERT_GPU_LIBRARY}" CACHE FILEPATH "Explicit matching GPU library")
    set(${prefix}_DEPS_PREFIX "" CACHE PATH "Optional dependency prefix (prefer CMAKE_PREFIX_PATH)")
endmacro()

function(_bert_library out explicit name build_root)
    if(explicit)
        if(NOT EXISTS "${explicit}" OR IS_DIRECTORY "${explicit}")
            message(FATAL_ERROR "${out} must name an existing compatible library: ${explicit}")
        endif()
        set(${out} "${explicit}" PARENT_SCOPE)
        return()
    endif()
    if(NOT build_root)
        message(FATAL_ERROR "Set BERT_PREBUILT_BUILD or explicitly set ${out}; no historical build tree is selected automatically")
    endif()
    # Both the ordinary Poseidon build and the former standalone BERT build are
    # supported. NO_DEFAULT_PATH prevents silently mixing unrelated system ABIs.
    find_library(_bert_found NAMES "${name}" NO_CACHE NO_DEFAULT_PATH
        PATHS "${build_root}" "${build_root}/lib" "${build_root}/lib64"
        PATH_SUFFIXES "" gpu runtime-api ckks-runtime src/poseidon/gpu
            src/poseidon/runtime_api poseidon-build poseidon-build/src/poseidon/gpu
            poseidon-build/src/poseidon/runtime_api poseidon-build/ckks-runtime)
    if(NOT _bert_found)
        message(FATAL_ERROR "Cannot find ${name} in ${build_root}. Set ${out} explicitly to a compatible library")
    endif()
    set(${out} "${_bert_found}" PARENT_SCOPE)
endfunction()

function(_bert_logging_dependencies)
    find_package(spdlog REQUIRED)
    # RMM's child directories also need to see imported logging targets.
    foreach(_target IN ITEMS spdlog::spdlog spdlog::spdlog_header_only fmt::fmt fmt::fmt-header-only)
        if(TARGET ${_target})
            get_target_property(_imported ${_target} IMPORTED)
            get_target_property(_alias ${_target} ALIASED_TARGET)
            if(_imported AND NOT _alias)
                set_target_properties(${_target} PROPERTIES IMPORTED_GLOBAL TRUE)
            endif()
        endif()
    endforeach()
endfunction()

function(bert_setup_dependencies)
    cmake_parse_arguments(BERT_DEP "GPU;RUNTIME" "PREFIX" "" ${ARGN})
    if(BERT_DEP_RUNTIME)
        set(BERT_DEP_GPU TRUE)
    endif()
    if(TARGET bert::cpu AND (NOT BERT_DEP_GPU OR TARGET bert::gpu)
            AND (NOT BERT_DEP_RUNTIME OR TARGET bert::runtime_gpu_api))
        return()
    endif()
    if(TARGET bert::cpu)
        message(FATAL_ERROR "Configure the GPU/Runtime dependencies before CPU-only engines in this build tree")
    endif()

    set(_root "${POSEIDON_ROOT}")
    set(_build "${BERT_PREBUILT_BUILD}")
    set(_cpu "${BERT_CPU_LIBRARY}")
    set(_gpu "${BERT_GPU_LIBRARY}")
    if(BERT_DEP_PREFIX)
        foreach(_pair IN ITEMS "POSEIDON_ROOT;_root" "PREBUILT_BUILD;_build" "CPU_LIBRARY;_cpu" "GPU_LIBRARY;_gpu")
            list(GET _pair 0 _suffix)
            list(GET _pair 1 _destination)
            if(${BERT_DEP_PREFIX}_${_suffix})
                set(${_destination} "${${BERT_DEP_PREFIX}_${_suffix}}")
            endif()
        endforeach()
        if(${BERT_DEP_PREFIX}_DEPS_PREFIX)
            list(PREPEND CMAKE_PREFIX_PATH "${${BERT_DEP_PREFIX}_DEPS_PREFIX}")
        endif()
    endif()
    if(NOT EXISTS "${_root}/src/poseidon/gpu/CMakeLists.txt")
        message(FATAL_ERROR "POSEIDON_ROOT is not a complete Poseidon source tree: ${_root}")
    endif()
    if(NOT _root STREQUAL POSEIDON_ROOT AND
            POSEIDON_CKKS_RUNTIME_SOURCE_DIR STREQUAL "${POSEIDON_ROOT}/third_party/ckks-runtime")
        set(POSEIDON_CKKS_RUNTIME_SOURCE_DIR "${_root}/third_party/ckks-runtime")
    endif()
    string(TOUPPER "${BERT_DEPENDENCY_MODE}" _mode)
    if(_mode STREQUAL "AUTO")
        if(_build OR _cpu OR _gpu OR BERT_API_LIBRARY OR BERT_CORE_LIBRARY OR BERT_JSON_LIBRARY)
            set(_mode PREBUILT)
        else()
            set(_mode SOURCE)
        endif()
    endif()
    if(NOT _mode MATCHES "^(SOURCE|PREBUILT)$")
        message(FATAL_ERROR "BERT_DEPENDENCY_MODE must be AUTO, SOURCE, or PREBUILT")
    endif()
    message(STATUS "BERT dependency mode: ${_mode}")
    list(PREPEND CMAKE_MODULE_PATH "${_root}/cmake")
    if(BERT_DEP_GPU)
        # Create toolkit imports in the caller's directory, not only inside the
        # Poseidon subdirectory, so sibling prepared/runner targets can use them.
        find_package(CUDAToolkit REQUIRED)
    endif()

    if(_mode STREQUAL "SOURCE")
        foreach(_option IN ITEMS POSEIDON_BUILD_EXAMPLES POSEIDON_BUILD_BENCH
                POSEIDON_BUILD_DEPS POSEIDON_USE_ZLIB POSEIDON_USE_ZSTD POSEIDON_USE_MSGSL
                POSEIDON_BUILD_CKKS_RUNTIME_TESTS POSEIDON_BUILD_CKKS_RUNTIME_GPU_TESTS
                POSEIDON_BUILD_CKKS_RUNTIME_MPI POSEIDON_BUILD_CKKS_RUNTIME_GPU_NCCL
                CKKS_RUNTIME_BUILD_TESTS CKKS_RUNTIME_BUILD_EXPERIMENTS CKKS_RUNTIME_BUILD_MPI)
            set(${_option} OFF CACHE BOOL "Optional Poseidon dependency feature")
        endforeach()
        set(POSEIDON_BUILD_GPU "${BERT_DEP_GPU}" CACHE BOOL "Build Poseidon GPU dependencies" FORCE)
        set(POSEIDON_BUILD_CKKS_RUNTIME_API "${BERT_DEP_RUNTIME}" CACHE BOOL "Build Runtime API dependencies" FORCE)
        if(BERT_DEP_GPU)
            bert_default_cuda_architectures()
        endif()
        if(NOT TARGET poseidon_shared)
            if(BERT_PREBUILT_CPU_LIBRARY)
                if(NOT EXISTS "${BERT_PREBUILT_CPU_LIBRARY}")
                    message(FATAL_ERROR "BERT_PREBUILT_CPU_LIBRARY does not exist: ${BERT_PREBUILT_CPU_LIBRARY}")
                endif()
                # Legacy optional CPU-only import: never import GPU/API archives
                # implicitly. The caller is responsible for matching CPU ABI.
                find_package(GMP REQUIRED MODULE)
                _bert_logging_dependencies()
                find_package(Threads REQUIRED)
                find_package(OpenMP REQUIRED)
                configure_file("${_root}/src/poseidon/util/config.h.in"
                    "${CMAKE_CURRENT_BINARY_DIR}/poseidon/util/config.h")
                add_library(poseidon_shared SHARED IMPORTED GLOBAL)
                set_target_properties(poseidon_shared PROPERTIES IMPORTED_LOCATION "${BERT_PREBUILT_CPU_LIBRARY}")
                target_include_directories(poseidon_shared INTERFACE "${_root}/src" "${CMAKE_CURRENT_BINARY_DIR}")
                target_link_libraries(poseidon_shared INTERFACE GMP::gmpxx spdlog::spdlog Threads::Threads OpenMP::OpenMP_CXX)
                set(POSEIDON_INCLUDES_DIR "${_root}")
                if(BERT_DEP_RUNTIME)
                    add_subdirectory("${POSEIDON_CKKS_RUNTIME_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/ckks-runtime" EXCLUDE_FROM_ALL)
                endif()
                if(BERT_DEP_GPU)
                    add_subdirectory("${_root}/src/poseidon/gpu" "${CMAKE_CURRENT_BINARY_DIR}/gpu")
                endif()
                if(BERT_DEP_RUNTIME)
                    add_subdirectory("${_root}/src/poseidon/runtime_api" "${CMAKE_CURRENT_BINARY_DIR}/runtime-api")
                endif()
            else()
                add_subdirectory("${_root}" "${CMAKE_CURRENT_BINARY_DIR}/poseidon-build" EXCLUDE_FROM_ALL)
                target_include_directories(poseidon_shared INTERFACE "${CMAKE_CURRENT_BINARY_DIR}/poseidon-build")
            endif()
        endif()
        if(BERT_DEP_GPU AND NOT TARGET poseidon::gpu)
            message(FATAL_ERROR "The parent Poseidon build must enable POSEIDON_BUILD_GPU")
        endif()
        if(BERT_DEP_RUNTIME AND NOT TARGET poseidon::runtime_gpu_api)
            message(FATAL_ERROR "The parent Poseidon build must enable POSEIDON_BUILD_CKKS_RUNTIME_API")
        endif()
        add_library(bert_cpu_dependency INTERFACE)
        target_link_libraries(bert_cpu_dependency INTERFACE poseidon_shared)
        if(BERT_DEP_GPU)
            add_library(bert_gpu_dependency INTERFACE)
            target_link_libraries(bert_gpu_dependency INTERFACE poseidon::gpu)
        endif()
        if(BERT_DEP_RUNTIME)
            add_library(bert_runtime_gpu_dependency INTERFACE)
            target_link_libraries(bert_runtime_gpu_dependency INTERFACE poseidon::runtime_gpu_api)
            add_library(bert_plan_json_dependency INTERFACE)
            target_link_libraries(bert_plan_json_dependency INTERFACE ckks_runtime::plan_json)
        endif()
    else()
        if(BERT_PREBUILT_CPU_LIBRARY)
            message(FATAL_ERROR "Use BERT_CPU_LIBRARY in PREBUILT mode, not the SOURCE-mode BERT_PREBUILT_CPU_LIBRARY")
        endif()
        find_package(GMP REQUIRED MODULE)
        _bert_logging_dependencies()
        find_package(Threads REQUIRED)
        find_package(OpenMP REQUIRED)
        _bert_library(BERT_CPU_LIBRARY "${_cpu}" poseidon_shared "${_build}")
        if(BERT_CONFIG_INCLUDE_DIR)
            set(_config "${BERT_CONFIG_INCLUDE_DIR}")
        else()
            find_path(_config NAMES poseidon/util/config.h NO_CACHE NO_DEFAULT_PATH
                PATHS "${_build}" "${_build}/poseidon-build" "${_build}/include")
        endif()
        if(NOT _config OR NOT EXISTS "${_config}/poseidon/util/config.h")
            message(FATAL_ERROR "Set BERT_CONFIG_INCLUDE_DIR to the matching generated header directory (poseidon/util/config.h)")
        endif()
        add_library(bert_cpu_dependency UNKNOWN IMPORTED GLOBAL)
        set_target_properties(bert_cpu_dependency PROPERTIES IMPORTED_LOCATION "${BERT_CPU_LIBRARY}")
        target_include_directories(bert_cpu_dependency INTERFACE "${_root}/src" "${_config}")
        target_link_libraries(bert_cpu_dependency INTERFACE GMP::gmpxx spdlog::spdlog Threads::Threads OpenMP::OpenMP_CXX)
        if(BERT_DEP_GPU)
            find_package(CUDAToolkit REQUIRED)
            _bert_library(BERT_GPU_LIBRARY "${_gpu}" poseidon_gpu "${_build}")
            add_library(bert_gpu_dependency UNKNOWN IMPORTED GLOBAL)
            set_target_properties(bert_gpu_dependency PROPERTIES IMPORTED_LOCATION "${BERT_GPU_LIBRARY}")
            target_include_directories(bert_gpu_dependency INTERFACE
                "${_root}/third_party/rmm/include" "${_root}/third_party/cccl/thrust"
                "${_root}/third_party/cccl/libcudacxx/include" "${_root}/third_party/cccl/cub"
                "${_root}/third_party/nvtx/c/include")
            target_compile_definitions(bert_gpu_dependency INTERFACE FMT_HEADER_ONLY=1
                SPDLOG_COMPILED_LIB SPDLOG_FMT_EXTERNAL LIBCUDACXX_ENABLE_EXPERIMENTAL_MEMORY_RESOURCE
                THRUST_DEVICE_SYSTEM=THRUST_DEVICE_SYSTEM_CUDA THRUST_DISABLE_ABI_NAMESPACE
                THRUST_HOST_SYSTEM=THRUST_HOST_SYSTEM_CPP THRUST_IGNORE_ABI_NAMESPACE_ERROR)
            target_link_libraries(bert_gpu_dependency INTERFACE bert_cpu_dependency CUDA::cudart)
        endif()
        if(BERT_DEP_RUNTIME)
            _bert_library(BERT_API_LIBRARY "${BERT_API_LIBRARY}" poseidon_runtime_gpu_api "${_build}")
            _bert_library(BERT_CORE_LIBRARY "${BERT_CORE_LIBRARY}" runtime_core "${_build}")
            _bert_library(BERT_JSON_LIBRARY "${BERT_JSON_LIBRARY}" runtime_plan_json "${_build}")
            add_library(bert_runtime_core_dependency UNKNOWN IMPORTED GLOBAL)
            set_target_properties(bert_runtime_core_dependency PROPERTIES IMPORTED_LOCATION "${BERT_CORE_LIBRARY}")
            target_include_directories(bert_runtime_core_dependency INTERFACE
                "${POSEIDON_CKKS_RUNTIME_SOURCE_DIR}" "${POSEIDON_CKKS_RUNTIME_SOURCE_DIR}/third_party")
            target_link_libraries(bert_runtime_core_dependency INTERFACE Threads::Threads)
            add_library(bert_plan_json_dependency UNKNOWN IMPORTED GLOBAL)
            set_target_properties(bert_plan_json_dependency PROPERTIES IMPORTED_LOCATION "${BERT_JSON_LIBRARY}")
            target_link_libraries(bert_plan_json_dependency INTERFACE bert_runtime_core_dependency)
            add_library(bert_runtime_gpu_dependency UNKNOWN IMPORTED GLOBAL)
            set_target_properties(bert_runtime_gpu_dependency PROPERTIES IMPORTED_LOCATION "${BERT_API_LIBRARY}")
            target_link_libraries(bert_runtime_gpu_dependency INTERFACE bert_gpu_dependency bert_runtime_core_dependency CUDA::cufft)
            if(BERT_PREBUILT_WITH_NCCL_MPI)
                find_package(MPI REQUIRED COMPONENTS CXX)
                find_library(BERT_NCCL_LIBRARY NAMES nccl REQUIRED)
                target_link_libraries(bert_runtime_gpu_dependency INTERFACE MPI::MPI_CXX "${BERT_NCCL_LIBRARY}")
                target_compile_definitions(bert_runtime_gpu_dependency INTERFACE POSEIDON_RUNTIME_GPU_NCCL=1)
            endif()
        endif()
    endif()
    add_library(bert::cpu ALIAS bert_cpu_dependency)
    if(BERT_DEP_GPU)
        add_library(bert::gpu ALIAS bert_gpu_dependency)
    endif()
    if(BERT_DEP_RUNTIME)
        add_library(bert::runtime_gpu_api ALIAS bert_runtime_gpu_dependency)
        add_library(bert::plan_json ALIAS bert_plan_json_dependency)
    endif()
endfunction()
